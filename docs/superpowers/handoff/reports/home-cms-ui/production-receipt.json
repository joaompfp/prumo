    "revision": [
      {
        "id": 6,
        "kind": "page",
        "slug": "inicio",
        "body_json": "{\"blocks\":[{\"actions\":[{\"href\":\"/temas/economy\",\"label\":\"Explorar os dados\"},{\"href\":\"/metodologia\",\"label\":\"Como verificamos\"}],\"counts\":true,\"eyebrow\":\"Dados oficiais · proveniência verificada\",\"freshness\":true,\"note\":\"Cada valor liga à publicação original, à data em que foi recolhido e à verificação independente que o acompanhou.\",\"title\":\"Estatísticas oficiais, com a proveniência à vista.\",\"type\":\"hero\"},{\"note\":\"Portugal. Valores publicados tal como a fonte os publica.\",\"title\":\"Números em destaque\",\"type\":\"heading\"},{\"derived_key\":null,\"label\":\"Inflação (IHPC)\",\"series_id\":\"ine.hicp_yoy.PT\",\"type\":\"card\"},{\"derived_key\":\"derived.unemployment_monthly.PT.yoy_change\",\"label\":\"Desemprego\",\"series_id\":\"ine.unemployment_monthly.PT\",\"type\":\"card\"},{\"derived_key\":\"derived.ipi_seasonal_cae_TOT.PT.yoy_change_pct\",\"label\":\"Produção industrial\",\"series_id\":\"ine.ipi_seasonal_cae_TOT.PT\",\"type\":\"card\"},{\"derived_key\":\"derived.cci.PT.period_change\",\"label\":\"Confiança dos consumidores\",\"series_id\":\"eurostat.cci.PT\",\"type\":\"card\"},{\"derived_key\":null,\"label\":\"Confiança da indústria\",\"series_id\":\"ine.conf_manufacturing.PT\",\"type\":\"card\"},{\"derived_key\":\"derived.credit_consumer.PT.yoy_change_pct\",\"label\":\"Crédito ao consumo\",\"series_id\":\"bportugal.credit_consumer.PT\",\"type\":\"card\"},{\"derived_key\":\"derived.deposits_households.PT.yoy_change_pct\",\"label\":\"Depósitos das famílias\",\"series_id\":\"bportugal.deposits_households.PT\",\"type\":\"card\"},{\"derived_key\":\"derived.pt_10y.PT.yoy_change\",\"label\":\"Dívida pública a 10 anos\",\"series_id\":\"bportugal.pt_10y.PT\",\"type\":\"card\"},{\"derived_key\":\"derived.population.PT.yoy_change_pct\",\"label\":\"População residente\",\"series_id\":\"ine.population.PT\",\"type\":\"card\"},{\"derived_key\":\"derived.live_births.PT.yoy_change_pct\",\"label\":\"Nados-vivos\",\"series_id\":\"ine.live_births.PT\",\"type\":\"card\"},{\"derived_key\":\"derived.exports_monthly.PT.yoy_change_pct\",\"label\":\"Exportações de bens\",\"series_id\":\"ine.exports_monthly.PT\",\"type\":\"card\"},{\"derived_key\":null,\"label\":\"Preço da eletricidade\",\"series_id\":\"eurostat.electricity_price_household.PT\",\"type\":\"card\"},{\"note\":\"Todo o catálogo, por assunto.\",\"themes\":[\"economy\",\"demography\",\"energy\"],\"title\":\"Temas\",\"type\":\"themes\"},{\"action\":{\"href\":\"/metodologia\",\"label\":\"Ler a metodologia completa\"},\"steps\":[{\"label\":\"Recolha\",\"text\":\"O ficheiro original é guardado intacto, com o endereço, a hora e o resumo criptográfico.\"},{\"label\":\"Validação\",\"text\":\"Unidade, período, sinal e duplicados são verificados antes de qualquer valor ser aceite.\"},{\"label\":\"Verificação independente\",\"text\":\"Uma amostra aleatória é comparada com outra via da mesma instituição, exigindo 100% de coincidência.\"}],\"title\":\"A cadeia de verificação\",\"type\":\"verification\"},{\"action\":{\"href\":\"/fontes\",\"label\":\"Licenças, atribuições e fontes em avaliação\"},\"note\":\"\",\"title\":\"Instituições publicadas\",\"type\":\"sources\"}],\"introduction\":\"\",\"section\":\"general\",\"title\":\"Início\"}",
        "created_at": "2026-11-17T09:57:20.977540+00:00",
        "actor": "joao"
      }
