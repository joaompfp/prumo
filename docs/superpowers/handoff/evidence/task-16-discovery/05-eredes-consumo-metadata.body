{"visibility": "domain", "fields": [{"name": "datahora", "description": null, "annotations": {"facetsort": "-count", "facet": true, "timerangeFilter": true, "timeserie_precision": "minute"}, "label": "Date/Time", "type": "datetime", "label_en": "Date/Time", "label_pt": "Data/Hora", "description_en": null, "description_pt": null}, {"name": "dia", "description": null, "annotations": {"facet": true, "disjunctive": true}, "label": "Day", "type": "text", "label_en": "Day", "label_pt": "Dia", "description_en": null, "description_pt": null}, {"name": "mes", "description": null, "annotations": {"facet": true}, "label": "Month", "type": "text", "label_en": "Month", "label_pt": "M\u00eas", "description_en": null, "description_pt": null}, {"name": "ano", "description": null, "annotations": {"facet": true, "disjunctive": true}, "label": "Year", "type": "text", "label_en": "Year", "label_pt": "Ano", "description_en": null, "description_pt": null}, {"name": "date", "description": null, "annotations": {"facetsort": "-count", "timeserie_precision": "day", "facet": true}, "label": "Date", "type": "date", "label_en": "Date", "label_pt": "Data", "description_en": null, "description_pt": null}, {"name": "time", "description": null, "annotations": {"facetsort": "-count", "facet": true}, "label": "Hour", "type": "text", "label_en": "Hour", "label_pt": "Hora", "description_en": null, "description_pt": null}, {"name": "bt", "description": null, "annotations": {}, "label": "Low Voltage (kWh)", "type": "double", "label_en": "Low Voltage (kWh)", "label_pt": "Baixa Tens\u00e3o (kWh)", "description_en": null, "description_pt": null}, {"name": "mt", "description": null, "annotations": {}, "label": "Medium Voltage (kWh)", "type": "double", "label_en": "Medium Voltage (kWh)", "label_pt": "M\u00e9dia Tens\u00e3o (kWh)", "description_en": null, "description_pt": null}, {"name": "at", "description": null, "annotations": {}, "label": "High Voltage (kWh)", "type": "double", "label_en": "High Voltage (kWh)", "label_pt": "Alta Tens\u00e3o (kWh)", "description_en": null, "description_pt": null}, {"name": "mat", "description": null, "annotations": {}, "label": "Very High Voltage (kWh)", "type": "double", "label_en": "Very High Voltage (kWh)", "label_pt": "Muito Alta Tens\u00e3o (kWh)", "description_en": null, "description_pt": null}, {"name": "total", "description": null, "annotations": {"facetsort": "-count"}, "label": "Total (kWh)", "type": "double", "label_en": "Total (kWh)", "label_pt": "Total (kWh)", "description_en": null, "description_pt": null}], "dataset_id": "consumo-total-nacional", "dataset_uid": "da_asqs6b", "has_records": true, "features": ["analyze", "timeserie"], "attachments": [], "alternative_exports": [], "data_visible": true, "metas": {"default": {"title": "Total National Consumption", "title_en": "Total National Consumption", "title_pt": "Consumo Total Nacional", "description": "<p>This Dataset represents total energy consumption at national level.</p><p>The Dataset is composed of the following elements:</p><ul><li>Energy consumption of installations with MAT voltage level (very high voltage);</li><li>Energy consumption of installations with AT voltage level (high voltage);</li><li>Energy consumption of installations with MT (medium voltage) voltage level;</li><li>Energy consumption of installations with BT voltage level (low voltage);</li><li>Sum of energy consumption of all voltage levels (Total).</li></ul><p>The data is obtained through information on consumption with network losses by voltage level.\u00a0At the end of each 15-minute period, the meter stores the total amount of energy during that interval.</p><p>The update frequency is daily.</p><p><b>Use case</b>: This data allows you to monitor national energy consumption, quarter-hourly by voltage level.</p><p><br></p><p>1. The information made available by E-REDES constitutes an approximation to the values taken from the system and is based on the moment in which it is collected. Given that the connection points, the electricity distribution network, and the consumption and production values themselves are naturally very dynamic, it is safeguarded that the information made available may be subject to subsequent changes and updates, with the exception of any omissions and/or occasional inaccuracies of location that the information may contain.</p><p>2. In this way, E-REDES is not liable to third parties, namely, partners, service providers, contractors, users and customers, for damages that may arise as a result, direct or indirect, of the use of this Information, in particular when carrying out interventions, calculations and/or estimates, without confirming the accuracy and updating of the data, whereby it is duly noted that the consultation of this information does not affect the duty to promote a direct consultation with E-REDES in order to obtain updated information.</p><p><br></p><p>The data provided by the E-REDES Open Data Portal is covered by open licenses (CC BY 4.0). There are no restrictions on access, under the commitment that data users cite the publisher. Therefore, we suggest that you cite the Open Data E-REDES Portal as:</p><p>E-REDES \u2013 Distribui\u00e7\u00e3o de Eletricidade, \u201cE-REDES Open Data Portal\u201d. Accessed in \u201cData\u201d. [Online] Available at https://e-redes.opendatasoft.com/pages/homepage/</p><p>If you share on social media, please add #PortalOpenData_E_REDES</p>", "description_en": "<p>This Dataset represents total energy consumption at national level.</p><p>The Dataset is composed of the following elements:</p><ul><li>Energy consumption of installations with MAT voltage level (very high voltage);</li><li>Energy consumption of installations with AT voltage level (high voltage);</li><li>Energy consumption of installations with MT (medium voltage) voltage level;</li><li>Energy consumption of installations with BT voltage level (low voltage);</li><li>Sum of energy consumption of all voltage levels (Total).</li></ul><p>The data is obtained through information on consumption with network losses by voltage level.\u00a0At the end of each 15-minute period, the meter stores the total amount of energy during that interval.</p><p>The update frequency is daily.</p><p><b>Use case</b>: This data allows you to monitor national energy consumption, quarter-hourly by voltage level.</p><p><br></p><p>1. The information made available by E-REDES constitutes an approximation to the values taken from the system and is based on the moment in which it is collected. Given that the connection points, the electricity distribution network, and the consumption and production values themselves are naturally very dynamic, it is safeguarded that the information made available may be subject to subsequent changes and updates, with the exception of any omissions and/or occasional inaccuracies of location that the information may contain.</p><p>2. In this way, E-REDES is not liable to third parties, namely, partners, service providers, contractors, users and customers, for damages that may arise as a result, direct or indirect, of the use of this Information, in particular when carrying out interventions, calculations and/or estimates, without confirming the accuracy and updating of the data, whereby it is duly noted that the consultation of this information does not affect the duty to promote a direct consultation with E-REDES in order to obtain updated information.</p><p><br></p><p>The data provided by the E-REDES Open Data Portal is covered by open licenses (CC BY 4.0). There are no restrictions on access, under the commitment that data users cite the publisher. Therefore, we suggest that you cite the Open Data E-REDES Portal as:</p><p>E-REDES \u2013 Distribui\u00e7\u00e3o de Eletricidade, \u201cE-REDES Open Data Portal\u201d. Accessed in \u201cData\u201d. [Online] Available at https://e-redes.opendatasoft.com/pages/homepage/</p><p>If you share on social media, please add #PortalOpenData_E_REDES</p>", "description_pt": "<p style=\"\">Este Dataset representa o total de consumo de energia a n\u00edvel nacional.</p><p>O Dataset \u00e9 composto pelos seguintes elementos: </p><ul><li>Consumo energia das instala\u00e7\u00f5es com n\u00edvel de tens\u00e3o MAT (muito alta tens\u00e3o);</li><li>Consumo energia das instala\u00e7\u00f5es com n\u00edvel de tens\u00e3o AT (alta tens\u00e3o);</li><li>Consumo energia das instala\u00e7\u00f5es com n\u00edvel de tens\u00e3o MT (m\u00e9dia tens\u00e3o);</li><li>Consumo energia das instala\u00e7\u00f5es com n\u00edvel de tens\u00e3o\u00a0BT (baixa tens\u00e3o);</li><li>Soma do consumo de energia de todos os n\u00edveis de tens\u00e3o (Total).</li></ul><p></p><p style=\"\">Os dados s\u00e3o obtidos atrav\u00e9s da informa\u00e7\u00e3o de consumos com perdas na rede por n\u00edvel de tens\u00e3o.\u00a0<span style=\"font-size: 0.875rem;\">No final de cada per\u00edodo de 15 minutos, o medidor armazena o valor total de energia durante esse intervalo.</span></p><p style=\"\"></p><p style=\"\">A periodicidade de atualiza\u00e7\u00e3o \u00e9 di\u00e1ria.</p><p style=\"\"><b>Use case</b>: Estes dados permitem fazer o acompanhamento dos consumos de energia nacionais, quarto-hor\u00e1rios por n\u00edvel de tens\u00e3o.</p><p style=\"\"><br></p><p>1. A Informa\u00e7\u00e3o disponibilizada pela E-REDES constitui uma aproxima\u00e7\u00e3o aos valores retirados de sistema e tem por refer\u00eancia o momento em que a mesma \u00e9 recolhida. Atendendo a que os pontos de liga\u00e7\u00e3o, a rede de distribui\u00e7\u00e3o de eletricidade, e os pr\u00f3prios valores de consumo e de produ\u00e7\u00e3o s\u00e3o naturalmente muito din\u00e2micos, salvaguarda-se que a informa\u00e7\u00e3o disponibilizada poder\u00e1 ser objeto de subsequentes altera\u00e7\u00f5es e atualiza\u00e7\u00f5es, ficando igualmente ressalvadas eventuais omiss\u00f5es e/ou pontuais imprecis\u00f5es de localiza\u00e7\u00e3o que a informa\u00e7\u00e3o poder\u00e1 conter.<br></p><p></p><p>2. Desta forma a E-REDES n\u00e3o se responsabiliza perante terceiros, nomeadamente, parceiros, prestadores de servi\u00e7os, empreiteiros, utentes e clientes, pelos danos que possam surgir em consequ\u00eancia, direta ou indireta, do uso da presente Informa\u00e7\u00e3o, em particular aquando da realiza\u00e7\u00e3o de interven\u00e7\u00f5es, c\u00e1lculos e/ou estimativas, sem confirma\u00e7\u00e3o da exatid\u00e3o e atualiza\u00e7\u00e3o dos dados, pelo que devidamente se ressalva de que a consulta da presente informa\u00e7\u00e3o n\u00e3o prejudica o dever de se promover uma consulta direta \u00e0 E-REDES para obter informa\u00e7\u00e3o atualizada.</p><p><br></p><p><span style=\"font-size: inherit;\">Os dados fornecidos pelo Portal Open Data da E-REDES s\u00e3o abrangidos por licen\u00e7as abertas (</span><a aria-label=\"Link CC BY 4.0\" class=\"fui-Link ___1rxvrpe f2hkw1w f3rmtva f1ewtqcl fyind8e f1k6fduh f1w7gpdv fk6fouc fjoy568 figsok6 f1hu3pq6 f11qmguv f19f4twv f1tyq0we f1g0x7ka fhxju0i f1qch9an f1cnd47f fqv5qza f1vmzxwi f1o700av f13mvf36 f1cmlufx f9n3di6 f1ids18y f1tx3yz7 f1deo86v f1eh06m1 f1iescvh fhgqx19 f1olyrje f1p93eir f1nev41a f1h8hb77 f1lqvz6u f10aw75t fsle3fq f17ae5zn\" href=\"https://creativecommons.org/licenses/by/4.0/\" rel=\"noreferrer noopener\" target=\"_blank\" title=\"https://creativecommons.org/licenses/by/4.0/\">CC BY 4.0</a><span style=\"font-size: inherit;\">). N\u00e3o existem restri\u00e7\u00f5es ao seu acesso, sob o compromisso de os utilizadores dos dados citarem o publicador. Assim, sugerimos que cite o Portal Open Data E-REDES como:</span></p><p><span style=\"font-size: inherit;\">E-REDES \u2013 Distribui\u00e7\u00e3o de eletricidade, \u201cPortal Open Data E-REDES\u201d. Acedido em \u201cData\u201d. [Online] Dispon\u00edvel em </span><a aria-label=\"Link https://e-redes.opendatasoft.com/pages/homepage/\" class=\"fui-Link ___1rxvrpe f2hkw1w f3rmtva f1ewtqcl fyind8e f1k6fduh f1w7gpdv fk6fouc fjoy568 figsok6 f1hu3pq6 f11qmguv f19f4twv f1tyq0we f1g0x7ka fhxju0i f1qch9an f1cnd47f fqv5qza f1vmzxwi f1o700av f13mvf36 f1cmlufx f9n3di6 f1ids18y f1tx3yz7 f1deo86v f1eh06m1 f1iescvh fhgqx19 f1olyrje f1p93eir f1nev41a f1h8hb77 f1lqvz6u f10aw75t fsle3fq f17ae5zn\" href=\"https://e-redes.opendatasoft.com/pages/homepage/\" rel=\"noreferrer noopener\" target=\"_blank\" title=\"https://e-redes.opendatasoft.com/pages/homepage/\"><span style=\"font-size: inherit;\">https://e-redes.opendatasoft.com/pages/homepage/</span></a></p><p><span class=\"ui-provider a b c d e f g h i j k l m n o p q r s t u v w x y z ab ac ae af ag ah ai aj ak\" dir=\"ltr\"></span></p><p><span style=\"font-size: inherit;\">Se partilhar nas redes sociais, por favor acrescente #PortalOpenData_E_REDES</span></p>", "theme": ["Consumption and Energy"], "theme_en": ["Consumption and Energy"], "theme_pt": ["Consumos e Energia"], "keyword": null, "keyword_en": null, "keyword_pt": null, "license": "CC BY 4.0", "license_en": "CC BY 4.0", "license_pt": "CC BY 4.0", "license_url": "https://creativecommons.org/licenses/by/4.0/", "license_url_en": "https://creativecommons.org/licenses/by/4.0/", "license_url_pt": "https://creativecommons.org/licenses/by/4.0/", "language": "pt", "modified": "2026-11-12T14:35:26+00:00", "publisher": "E-REDES", "publisher_en": "E-REDES", "publisher_pt": "E-REDES", "references": null, "attributions": null, "update_frequency": null, "bbox": null, "data_processed": "2026-11-12T14:35:26+00:00", "federated": false, "geographic_reference": ["world_pt"], "geographic_reference_auto": false, "geometry_types": null, "metadata_languages": ["pt", "en"], "metadata_processed": "2026-11-12T14:35:26.556000+00:00", "modified_updates_on_data_change": true, "modified_updates_on_metadata_change": true, "parent_domain": null, "records_count": 450868, "shared_catalog": null, "source_dataset": null, "source_domain": null, "source_domain_address": null, "source_domain_title": null, "territory": ["Portugal"], "timezone": "Europe/Lisbon"}, "custom": {"perfis-de-utilizacao": null, "atualizado": null}}}