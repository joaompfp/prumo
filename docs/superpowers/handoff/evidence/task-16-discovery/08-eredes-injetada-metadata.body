{"visibility": "domain", "fields": [{"name": "datahora", "description": null, "annotations": {"facetsort": "-count", "facet": true, "timerangeFilter": true, "timeserie_precision": "minute"}, "label": "Date/Time", "type": "datetime", "label_en": "Date/Time", "label_pt": "Data/Hora", "description_en": null, "description_pt": null}, {"name": "dia", "description": null, "annotations": {"facet": true}, "label": "Day", "type": "text", "label_en": "Day", "label_pt": "Dia", "description_en": null, "description_pt": null}, {"name": "mes", "description": null, "annotations": {"facet": true}, "label": "Month", "type": "text", "label_en": "Month", "label_pt": "M\u00eas", "description_en": null, "description_pt": null}, {"name": "ano", "description": null, "annotations": {"facet": true}, "label": "Year", "type": "text", "label_en": "Year", "label_pt": "Ano", "description_en": null, "description_pt": null}, {"name": "date", "description": null, "annotations": {"facetsort": "-count", "timeserie_precision": "day", "facet": true}, "label": "Date", "type": "date", "label_en": "Date", "label_pt": "Data", "description_en": null, "description_pt": null}, {"name": "time", "description": null, "annotations": {"facetsort": "-count", "facet": true}, "label": "Hour", "type": "text", "label_en": "Hour", "label_pt": "Hora", "description_en": null, "description_pt": null}, {"name": "cogeracao", "description": null, "annotations": {}, "label": "Cogeneration (kWh)", "type": "double", "label_en": "Cogeneration (kWh)", "label_pt": "Cogera\u00e7\u00e3o (kWh)", "description_en": null, "description_pt": null}, {"name": "eolica", "description": null, "annotations": {}, "label": "Wind (kWh)", "type": "double", "label_en": "Wind (kWh)", "label_pt": "E\u00f3lica (kWh)", "description_en": null, "description_pt": null}, {"name": "fotovoltaica", "description": null, "annotations": {}, "label": "Photovoltaics (kWh)", "type": "double", "label_en": "Photovoltaics (kWh)", "label_pt": "Fotovoltaica (kWh)", "description_en": null, "description_pt": null}, {"name": "hidrica", "description": null, "annotations": {}, "label": "Hydro (kWh)", "type": "double", "label_en": "Hydro (kWh)", "label_pt": "H\u00eddrica (kWh)", "description_en": null, "description_pt": null}, {"name": "outras_tecnologias", "description": null, "annotations": {}, "label": "Other Technologies (kWh)", "type": "double", "label_en": "Other Technologies (kWh)", "label_pt": "Outras Tecnologias (kWh)", "description_en": null, "description_pt": null}, {"name": "rede_dist", "description": null, "annotations": {"facetsort": "-count"}, "label": " Distribution Network (kWh)", "type": "double", "label_en": " Distribution Network (kWh)", "label_pt": "Rede Distribui\u00e7\u00e3o (kWh)", "description_en": null, "description_pt": null}], "dataset_id": "energia-injetada-na-rede-de-distribuicao", "dataset_uid": "da_xtzwix", "has_records": true, "features": ["analyze", "timeserie"], "attachments": [], "alternative_exports": [], "data_visible": true, "metas": {"default": {"title": "Energy Injected into the Distribution Network", "title_en": "Energy Injected into the Distribution Network", "title_pt": "Energia Injetada na Rede de Distribui\u00e7\u00e3o", "description": "<p>This Dataset represents the origin of the energy that is injected into the Distribution network.</p><p>The Dataset is composed of the following elements:</p><ul><li>PRE - Production originating from producers under a special regime specifications by production technology.</li></ul><p>The data is obtained through production information from producers with guaranteed tariff (PRE) by technology.\u00a0At the end of each 15-minute period, the meter stores the total amount of energy during that interval.</p><p>The update frequency is daily.</p><p>Use case: This data allows monitoring of energy injected (PRE) into the distribution network in a given period, by production technology and allows the comparison of similar periods.</p><p><br></p><p>1. The information made available by E-REDES constitutes an approximation to the values taken from the system and is based on the moment in which it is collected. Given that the connection points, the electricity distribution network, and the consumption and production values themselves are naturally very dynamic, it is safeguarded that the information made available may be subject to subsequent changes and updates, with the exception of any omissions and/or occasional inaccuracies of location that the information may contain.</p><p>2. In this way, E-REDES is not liable to third parties, namely, partners, service providers, contractors, users and customers, for damages that may arise as a result, direct or indirect, of the use of this Information, in particular when carrying out interventions, calculations and/or estimates, without confirming the accuracy and updating of the data, whereby it is duly noted that the consultation of this information does not affect the duty to promote a direct consultation with E-REDES in order to obtain updated information.</p><p><br></p><p>The data provided by the E-REDES Open Data Portal is covered by open licenses (CC BY 4.0). There are no restrictions on access, under the commitment that data users cite the publisher. Therefore, we suggest that you cite the Open Data E-REDES Portal as:</p><p>E-REDES \u2013 Distribui\u00e7\u00e3o de Eletricidade, \u201cE-REDES Open Data Portal\u201d. Accessed in \u201cData\u201d. [Online] Available at https://e-redes.opendatasoft.com/pages/homepage/</p><p>If you share on social media, please add #PortalOpenData_E_REDES</p>", "description_en": "<p>This Dataset represents the origin of the energy that is injected into the Distribution network.</p><p>The Dataset is composed of the following elements:</p><ul><li>PRE - Production originating from producers under a special regime specifications by production technology.</li></ul><p>The data is obtained through production information from producers with guaranteed tariff (PRE) by technology.\u00a0At the end of each 15-minute period, the meter stores the total amount of energy during that interval.</p><p>The update frequency is daily.</p><p>Use case: This data allows monitoring of energy injected (PRE) into the distribution network in a given period, by production technology and allows the comparison of similar periods.</p><p><br></p><p>1. The information made available by E-REDES constitutes an approximation to the values taken from the system and is based on the moment in which it is collected. Given that the connection points, the electricity distribution network, and the consumption and production values themselves are naturally very dynamic, it is safeguarded that the information made available may be subject to subsequent changes and updates, with the exception of any omissions and/or occasional inaccuracies of location that the information may contain.</p><p>2. In this way, E-REDES is not liable to third parties, namely, partners, service providers, contractors, users and customers, for damages that may arise as a result, direct or indirect, of the use of this Information, in particular when carrying out interventions, calculations and/or estimates, without confirming the accuracy and updating of the data, whereby it is duly noted that the consultation of this information does not affect the duty to promote a direct consultation with E-REDES in order to obtain updated information.</p><p><br></p><p>The data provided by the E-REDES Open Data Portal is covered by open licenses (CC BY 4.0). There are no restrictions on access, under the commitment that data users cite the publisher. Therefore, we suggest that you cite the Open Data E-REDES Portal as:</p><p>E-REDES \u2013 Distribui\u00e7\u00e3o de Eletricidade, \u201cE-REDES Open Data Portal\u201d. Accessed in \u201cData\u201d. [Online] Available at https://e-redes.opendatasoft.com/pages/homepage/</p><p>If you share on social media, please add #PortalOpenData_E_REDES</p>", "description_pt": "<p>Este Dataset representa a proveni\u00eancia da energia que \u00e9 injetada na rede de Distribui\u00e7\u00e3o.</p><p>O Dataset \u00e9 composto pelos seguintes elementos:</p><ul><li>PRE - Produ\u00e7\u00e3o com proveni\u00eancia nos produtores em regime especial classificada por tecnologia de produ\u00e7\u00e3o.</li></ul><p>Os dados s\u00e3o obtidos atrav\u00e9s da informa\u00e7\u00e3o da produ\u00e7\u00e3o de produtores com tarifa garantida (PRE) por tecnologia.\u00a0<span style=\"font-size: 0.875rem;\">No final de cada per\u00edodo de 15 minutos, o medidor armazena o valor total de energia durante esse intervalo.</span></p><p>A periodicidade de atualiza\u00e7\u00e3o \u00e9 di\u00e1ria.</p><p><b>Use case</b>: Estes dados permitem fazer o acompanhamento da energia injetada (PRE) na rede de distribui\u00e7\u00e3o num determinado per\u00edodo, por tecnologia de produ\u00e7\u00e3o e permite a compara\u00e7\u00e3o de per\u00edodos hom\u00f3logos.</p><p><br></p><p>1. A Informa\u00e7\u00e3o disponibilizada pela E-REDES constitui uma aproxima\u00e7\u00e3o aos valores retirados de sistema e tem por refer\u00eancia o momento em que a mesma \u00e9 recolhida. Atendendo a que os pontos de liga\u00e7\u00e3o, a rede de distribui\u00e7\u00e3o de eletricidade, e os pr\u00f3prios valores de consumo e de produ\u00e7\u00e3o s\u00e3o naturalmente muito din\u00e2micos, salvaguarda-se que a informa\u00e7\u00e3o disponibilizada poder\u00e1 ser objeto de subsequentes altera\u00e7\u00f5es e atualiza\u00e7\u00f5es, ficando igualmente ressalvadas eventuais omiss\u00f5es e/ou pontuais imprecis\u00f5es de localiza\u00e7\u00e3o que a informa\u00e7\u00e3o poder\u00e1 conter.<br></p><p></p><p>2. Desta forma a E-REDES n\u00e3o se responsabiliza perante terceiros, nomeadamente, parceiros, prestadores de servi\u00e7os, empreiteiros, utentes e clientes, pelos danos que possam surgir em consequ\u00eancia, direta ou indireta, do uso da presente Informa\u00e7\u00e3o, em particular aquando da realiza\u00e7\u00e3o de interven\u00e7\u00f5es, c\u00e1lculos e/ou estimativas, sem confirma\u00e7\u00e3o da exatid\u00e3o e atualiza\u00e7\u00e3o dos dados, pelo que devidamente se ressalva de que a consulta da presente informa\u00e7\u00e3o n\u00e3o prejudica o dever de se promover uma consulta direta \u00e0 E-REDES para obter informa\u00e7\u00e3o atualizada.</p><p><br></p><p><span style=\"font-size: inherit;\">Os dados fornecidos pelo Portal Open Data da E-REDES s\u00e3o abrangidos por licen\u00e7as abertas (</span><a aria-label=\"Link CC BY 4.0\" class=\"fui-Link ___1rxvrpe f2hkw1w f3rmtva f1ewtqcl fyind8e f1k6fduh f1w7gpdv fk6fouc fjoy568 figsok6 f1hu3pq6 f11qmguv f19f4twv f1tyq0we f1g0x7ka fhxju0i f1qch9an f1cnd47f fqv5qza f1vmzxwi f1o700av f13mvf36 f1cmlufx f9n3di6 f1ids18y f1tx3yz7 f1deo86v f1eh06m1 f1iescvh fhgqx19 f1olyrje f1p93eir f1nev41a f1h8hb77 f1lqvz6u f10aw75t fsle3fq f17ae5zn\" href=\"https://creativecommons.org/licenses/by/4.0/\" rel=\"noreferrer noopener\" target=\"_blank\" title=\"https://creativecommons.org/licenses/by/4.0/\">CC BY 4.0</a><span style=\"font-size: inherit;\">). N\u00e3o existem restri\u00e7\u00f5es ao seu acesso, sob o compromisso de os utilizadores dos dados citarem o publicador. Assim, sugerimos que cite o Portal Open Data E-REDES como:</span></p><p><span style=\"font-size: inherit;\">E-REDES \u2013 Distribui\u00e7\u00e3o de eletricidade, \u201cPortal Open Data E-REDES\u201d. Acedido em \u201cData\u201d. [Online] Dispon\u00edvel em </span><a aria-label=\"Link https://e-redes.opendatasoft.com/pages/homepage/\" class=\"fui-Link ___1rxvrpe f2hkw1w f3rmtva f1ewtqcl fyind8e f1k6fduh f1w7gpdv fk6fouc fjoy568 figsok6 f1hu3pq6 f11qmguv f19f4twv f1tyq0we f1g0x7ka fhxju0i f1qch9an f1cnd47f fqv5qza f1vmzxwi f1o700av f13mvf36 f1cmlufx f9n3di6 f1ids18y f1tx3yz7 f1deo86v f1eh06m1 f1iescvh fhgqx19 f1olyrje f1p93eir f1nev41a f1h8hb77 f1lqvz6u f10aw75t fsle3fq f17ae5zn\" href=\"https://e-redes.opendatasoft.com/pages/homepage/\" rel=\"noreferrer noopener\" target=\"_blank\" title=\"https://e-redes.opendatasoft.com/pages/homepage/\"><span style=\"font-size: inherit;\">https://e-redes.opendatasoft.com/pages/homepage/</span></a></p><p><span class=\"ui-provider a b c d e f g h i j k l m n o p q r s t u v w x y z ab ac ae af ag ah ai aj ak\" dir=\"ltr\"></span></p><p><span style=\"font-size: inherit;\">Se partilhar nas redes sociais, por favor acrescente #PortalOpenData_E_REDES</span></p>", "theme": ["Consumption and Energy", "Renewables"], "theme_en": ["Consumption and Energy", "Renewables"], "theme_pt": ["Consumos e Energia", "Renov\u00e1veis"], "keyword": null, "keyword_en": null, "keyword_pt": null, "license": "CC BY 4.0", "license_en": "CC BY 4.0", "license_pt": "CC BY 4.0", "license_url": "https://creativecommons.org/licenses/by/4.0/", "license_url_en": "https://creativecommons.org/licenses/by/4.0/", "license_url_pt": "https://creativecommons.org/licenses/by/4.0/", "language": "pt", "modified": "2026-11-12T14:35:24+00:00", "publisher": "E-REDES", "publisher_en": "E-REDES", "publisher_pt": "E-REDES", "references": null, "attributions": null, "update_frequency": null, "bbox": null, "data_processed": "2026-11-12T14:35:24+00:00", "federated": false, "geographic_reference": ["world_pt"], "geographic_reference_auto": false, "geometry_types": null, "metadata_languages": ["pt", "en"], "metadata_processed": "2026-11-12T14:35:24.715000+00:00", "modified_updates_on_data_change": true, "modified_updates_on_metadata_change": true, "parent_domain": null, "records_count": 450964, "shared_catalog": null, "source_dataset": null, "source_domain": null, "source_domain_address": null, "source_domain_title": null, "territory": ["Portugal"], "timezone": "Europe/Lisbon"}, "custom": {"perfis-de-utilizacao": null, "atualizado": null}}}