", "label_en": "Year", "label_pt": "Ano", "description_en": null, "description_pt": null}, {"name": "code", "description": null, "annotations": {}, "label": "Installation Code", "type": "text", "label_en": "Installation Code", "label_pt": "C\u00f3digo", "description_en": null, "description_pt": null}, {"name": "tipoinstalacao", "description": null, "annotations": {}, "label": "Type of installation", "type": "text", "label_en": "Type of installation", "label_pt": "Tipo de Instala\u00e7\u00e3o", "description_en": null, "description_pt": null}, {"name": "name", "description": null, "annotations": {}, "label": "Designation", "type": "text", "label_en": "Designation", "label_pt": "Designa\u00e7\u00e3o", "description_en": null, "description_pt": null}, {"name": "busname", "description": null, "annotations": {}, "label": "Busbar", "type": "text", "label_en": "Busbar", "label_pt": "Barramento", "description_en": null, "description_pt": null}, {"name": "county", "description": null, "annotations": {}, "label": "Municipality", "type": "text", "label_en": "Municipality", "label_pt": "Concelho", "description_en": null, "description_pt": null}, {"name": "district", "description": null, "annotations": {}, "label": "NUTS III", "type": "text", "label_en": "NUTS III", "label_pt": "NUTS III", "description_en": null, "description_pt": null}, {"name": "tension", "description": null, "annotations": {}, "label": "Nominal Voltage (V)", "type": "text", "label_en": "Nominal Voltage (V)", "label_pt": "Tens\u00e3o nominal (V)", "description_en": null, "description_pt": null}, {"name": "startdate", "description": null, "annotations": {}, "label": "Start Date", "type": "date", "label_en": "Start Date", "label_pt": "Data de In\u00edcio", "description_en": null, "description_pt": null}, {"name": "enddate", "description": null, "annotations": {}, "label": "End Date", "type": "date", "label_en": "End Date", "label_pt": "Data do Fim", "description_en": null, "description_pt": null}, {"name": "l1", "description": null, "annotations": {}, "label": "Voltage L1", "type": "double", "label_en": "Voltage L1", "label_pt": "Tens\u00e3o L1", "description_en": null, "description_pt": null}, {"name": "l2", "description": null, "annotations": {}, "label": "Voltage L2", "type": "double", "label_en": "Voltage L2", "label_pt": "Tens\u00e3o L2", "description_en": null, "description_pt": null}, {"name": "l3", "description": null, "annotations": {}, "label": "Voltage L3", "type": "double", "label_en": "Voltage L3", "label_pt": "Tens\u00e3o L3", "description_en": null, "description_pt": null}, {"name": "l4", "description": null, "annotations": {}, "label": "Flicker L1", "type": "double", "label_en": "Flicker L1", "label_pt": "Flicker L1", "description_en": null, "description_pt": null}, {"name": "l5", "description": null, "annotations": {}, "label": "Flicker L2", "type": "double", "label_en": "Flicker L2", "label_pt": "Flicker L2", "description_en": null, "description_pt": null}, {"name": "l6", "description": null, "annotations": {}, "label": "Flicker L3", "type": "double", "label_en": "Flicker L3", "label_pt": "Flicker L3", "description_en": null, "description_pt": null}, {"name": "l7", "description": null, "annotations": {}, "label": "THD L1", "type": "double", "label_en": "THD L1", "label_pt": "THD L1", "description_en": null, "description_pt": null}, {"name": "l8", "description": null, "annotations": {}, "label": "THD L2", "type": "double", "label_en": "THD L2", "label_pt": "THD L2", "description_en": null, "description_pt": null}, {"name": "l9", "description": null, "annotations": {}, "label": "THD L3", "type": "double", "label_en": "THD L3", "label_pt": "THD L3", "description_en": null, "description_pt": null}, {"name": "unbalance", "description": null, "annotations": {}, "label": "Unbalanced", "type": "double", "label_en": "Unbalanced", "label_pt": "Desequil\u00edbrio", "description_en": null, "description_pt": null}, {"name": "frequency", "description": null, "annotations": {}, "label": "Frequency", "type": "double", "label_en": "Frequency", "label_pt": "Frequ\u00eancia", "description_en": null, "description_pt": null}, {"name": "harmonics", "description": null, "annotations": {}, "label": "Harmonics", "type": "text", "label_en": "Harmonics", "label_pt": "Harm\u00f3nicas", "description_en": null, "description_pt": null}, {"name": "observations", "description": null, "annotations": {}, "label": "Observations", "type": "text", "label_en": "Observations", "label_pt": "Observa\u00e7\u00f5es", "description_en": null, "description_pt": null}], "dataset_id": "qualidade_energia_fenomenoscontinuos-final", "dataset_uid": "da_bg4enb", "has_records": true, "features": ["analyze", "timeserie", "custom_view"], "attachments": [], "alternative_exports": [], "data_visible": true, "metas": {"default": {"title": "Electrical Power Quality - Continuous Phenomena", "title_en": "Electrical Power Quality - Continuous Phenomena", "title_pt": "Qualidade de Energia El\u00e9trica - Fen\u00f3menos Cont\u00ednuos", "description": "<p style=\"\">This dataset presents the voltage compliance analysis of MV busbars in HV/MV substations and LV busbars in distribution transformer stations, meeting the limits established by NP EN 50160.</p><p style=\"\">For each monitoring point, the following information is displayed for each voltage characteristic (rms voltage value, flicker, total harmonic distortion, unbalance, and fundamental frequency):</p><p style=\"\">Percentage of compliant values \u200b\u200bfor the indicated period, excluding exceptional events and high-impact incidents in the process of classification as exceptional events.</p><p style=\"\">Percentage of compliant values \u200b\u200bduring the period of each exceptional event and high-impact incident in the process of classification as exceptional events.</p><p style=\"\">For harmonic voltages with limits established by NP EN 50160, the minimum overall compliance percentage is presented.</p><p style=\"\">If it is a Substation:</p><ul><li>Voltage L1: Voltage RMS values L1-L2</li><li>Voltage L2: Voltage RMS values L2-L3</li><li>Voltage L3: Voltage RMS values L3-L1</li><li>Flicker Plt L1: Flicker Plt L1-L2</li><li><span style=\"font-family: inherit; font-size: 0.875rem;\">Flicker Plt L2: Flicker Plt L2-L3</span></li><li>Flicker Plt L3: Flicker Plt L3-L1</li><li>THD L1: Total harmonic distortion THD L1-L2</li><li>THD L2: Total harmonic distortion THD L2-L3</li><li>THD L3: Total harmonic distortion THD L3-L1</li></ul><p style=\"\">If it is a PTD:</p><ul><li><span style=\"font-family: inherit; font-size: 0.875rem;\">Voltage L1: Voltage RMS values L1-N</span></li><li>Voltage L2: Voltage RMS values L2-N</li><li>Voltage L3: Voltage RMS values L3-N</li><li>Flicker Plt L1: Flicker Plt L1-N</li><li>Flicker Plt L2: Flicker Plt L2-N</li><li>Flicker Plt L3: Flicker Plt L3-N</li><li>THD L1: Total harmonic distortion THD L1-N</li><li>THD L2: Total harmonic distortion THD L2-N</li><li>THD L3: Total harmonic distortion THD L3-N</li></ul><p style=\"\">The data are updated annually.</p><p style=\"\">These data are obtained from the application of successive biannual monitoring plans for a set of selected points in the distribution network. The selection of points takes into account a balanced geographic distribution, as well as the identification of customers as being more susceptible to voltage quality variations, according to the RQS.</p><p style=\"\"><br></p><p style=\"\">1. The information provided by E-REDES constitutes an approximation of the values \u200b\u200brelated to substations and the MV network as they are taken from the systems and are based on the time at which the information is collected.</p><p style=\"\">2. Given that connection points, the electricity distribution network, and consumption and production values \u200b\u200bthemselves are naturally highly dynamic, the information provided may be subject to subsequent changes and updates, and any omissions and/or occasional location inaccuracies that the information may contain are also taken into account.</p><p style=\"\">3. The information provided by E-REDES is merely an approximation of the available network capacity at any given time. Therefore, it does not constitute a contractual proposal, nor does it replace consultation with E-REDES for the purposes of formulating the usual grid connection requests (PLR).</p><p style=\"\">4. E-REDES ensures that the information provided does not imply connection to any specific grid point or asset, or even to a specific solution within the scope of the PLR \u200b\u200bthat may be proposed. E-REDES reserves the right to evaluate the most appropriate technical solution on a case-by-case basis, based on the respective requests, in accordance with the principles to which it is legally bound.</p><p style=\"\">5. E-REDES is not liable to third parties, including partners, service providers, contractors, users, and customers, for any damages that may arise directly or indirectly from the use of this Information, particularly when performing interventions, calculations, and/or estimates without confirming the accuracy and updating of the data. Therefore, it is duly noted that consulting this information does not prejudice the obligation to consult E-REDES directly for updated information.</p><p style=\"\">6. The information provided is, for all legal purposes, the property of E-REDES and may not be copied, reproduced, adapted, modified, altered, deleted, destroyed, disseminated, transmitted, disclosed, or otherwise made available to third parties without expressly authorizing it. Any reproduction, commercialization, or transfer to third parties, even free of charge, outside the specified terms or without the express authorization of E-REDES, is prohibited under applicable law and may result in civil and criminal liability.</p><p style=\"\"><br></p><p style=\"\">The data provided by the E-REDES Open Data Portal is covered by open licenses (CC BY 4.0). There are no restrictions on access, provided that data users are obliged to cite the publisher. Therefore, we suggest you cite the E-REDES Open Data Portal as:</p><p style=\"\">E-REDES \u2013 Electricity Distribution, \u201cE-REDES Open Data Portal.\u201d Accessed under \u201cData.\u201d [Online] Available at https://e-redes.opendatasoft.com/pages/homepage/</p><p style=\"\">If you share on social media, please add #PortalOpenDa</p>", "description_en": "<p style=\"\">This dataset presents the voltage compliance analysis of MV busbars in HV/MV substations and LV busbars in distribution transformer stations, meeting the limits established by NP EN 50160.</p><p style=\"\">For each monitoring point, the following information is displayed for each voltage characteristic (rms voltage value, flicker, total harmonic distortion, unbalance, and fundamental frequency):</p><p style=\"\">Percentage of compliant values \u200b\u200bfor the indicated period, excluding exceptional events and high-impact incidents in the process of classification as exceptional events.</p><p style=\"\">Percentage of compliant values \u200b\u200bduring the period of each exceptional event and high-impact incident in the process of classification as exceptional events.</p><p style=\"\">For harmonic voltages with limits established by NP EN 50160, the minimum overall compliance percentage is presented.</p><p style=\"\">If it is a Substation:</p><ul><li>Voltage L1: Voltage RMS values L1-L2</li><li>Voltage L2: Voltage RMS values L2-L3</li><li>Voltage L3: Voltage RMS values L3-L1</li><li>Flicker Plt L1: Flicker Plt L1-L2</li><li><span style=\"font-family: inherit; font-size: 0.875rem;\">Flicker Plt L2: Flicker Plt L2-L3</span></li><li>Flicker Plt L3: Flicker Plt L3-L1</li><li>THD L1: Total harmonic distortion THD L1-L2</li><li>THD L2: Total harmonic distortion THD L2-L3</li><li>THD L3: Total harmonic distortion THD L3-L1</li></ul><p style=\"\">If it is a PTD:</p><ul><li><span style=\"font-family: inherit; font-size: 0.875rem;\">Voltage L1: Voltage RMS values L1-N</span></li><li>Voltage L2: Voltage RMS values L2-N</li><li>Voltage L3: Voltage RMS values L3-N</li><li>Flicker Plt L1: Flicker Plt L1-N</li><li>Flicker Plt L2: Flicker Plt L2-N</li><li>Flicker Plt L3: Flicker Plt L3-N</li><li>THD L1: Total harmonic distortion THD L1-N</li><li>THD L2: Total harmonic distortion THD L2-N</li><li>THD L3: Total harmonic distortion THD L3-N</li></ul><p style=\"\">The data are updated annually.</p><p style=\"\">These data are obtained from the application of successive biannual monitoring plans for a set of selected points in the distribution network. The selection of points takes into account a balanced geographic distribution, as well as the identification of customers as being more susceptible to voltage quality variations, according to the RQS.</p><p style=\"\"><br></p><p style=\"\">1. The information provided by E-REDES constitutes an approximation of the values \u200b\u200brelated to substations and the MV network as they are taken from the systems and are based on the time at which the information is collected.</p><p style=\"\">2. Given that connection points, the electricity distribution network, and consumption and production values \u200b\u200bthemselves are naturally highly dynamic, the information provided may be subject to subsequent changes and updates, and any omissions and/or occasional location inaccuracies that the information may contain are also taken into account.</p><p style=\"\">3. The information provided by E-REDES is merely an approximation of the available network capacity at any given time. Therefore, it does not constitute a contractual proposal, nor does it replace consultation with E-REDES for the purposes of formulating the usual grid connection requests (PLR).</p><p style=\"\">4. E-REDES ensures that the information provided does not imply connection to any specific grid point or asset, or even to a specific solution within the scope of the PLR \u200b\u200bthat may be proposed. E-REDES reserves the right to evaluate the most appropriate technical solution on a case-by-case basis, based on the respective requests, in accordance with the principles to which it is legally bound.</p><p style=\"\">5. E-REDES is not liable to third parties, including partners, service providers, contractors, users, and customers, for any damages that may arise directly or indirectly from the use of this Information, particularly when performing interventions, calculations, and/or estimates without confirming the accuracy and updating of the data. Therefore, it is duly noted that consulting this information does not prejudice the obligation to consult E-REDES directly for updated information.</p><p style=\"\">6. The information provided is, for all legal purposes, the property of E-REDES and may not be copied, reproduced, adapted, modified, altered, deleted, destroyed, disseminated, transmitted, disclosed, or otherwise made available to third parties without expressly authorizing it. Any reproduction, commercialization, or transfer to third parties, even free of charge, outside the specified terms or without the express authorization of E-REDES, is prohibited under applicable law and may result in civil and criminal liability.</p><p style=\"\"><br></p><p style=\"\">The data provided by the E-REDES Open Data Portal is covered by open licenses (CC BY 4.0). There are no restrictions on access, provided that data users are obliged to cite the publisher. Therefore, we suggest you cite the E-REDES Open Data Portal as:</p><p style=\"\">E-REDES \u2013 Electricity Distribution, \u201cE-REDES Open Data Portal.\u201d Accessed under \u201cData.\u201d [Online] Available at https://e-redes.opendatasoft.com/pages/homepage/</p><p style=\"\">If you share on social media, please add #PortalOpenDa</p>", "description_pt": "<p>Este Dataset apresenta a an\u00e1lise de conformidade de tens\u00e3o dos barramentos MT de subesta\u00e7\u00f5es AT/MT e dos barramentos BT de postos de transforma\u00e7\u00e3o de distribui\u00e7\u00e3o, face aos limites da norma NP EN 50160.</p><p>Para cada um dos pontos de monitoriza\u00e7\u00e3o \u00e9 apresentada a seguinte informa\u00e7\u00e3o para cada caracter\u00edstica de tens\u00e3o (valor eficaz da tens\u00e3o, tremula\u00e7\u00e3o Plt (\"flicker\"), distor\u00e7\u00e3o harm\u00f3nica total, desequil\u00edbrio e frequ\u00eancia fundamental):</p><p>Percentagem de valores conformes, para o per\u00edodo indicado, excluindo eventos excecionais e incidentes de grande impacto em processo de classifica\u00e7\u00e3o como evento excecional</p><p>Percentagem de valores conformes, durante o per\u00edodo de cada evento excecional e incidente de grande impacto em processo de classifica\u00e7\u00e3o como evento excecional</p><p>Para as tens\u00f5es harm\u00f3nicas com limite estabelecido na norma NP EN 50160 \u00e9 apresentada a percentagem m\u00ednima de cumprimento global.</p><p>Se for Subesta\u00e7\u00e3o:</p><ul><li>Tens\u00e3o L1: Valor eficaz da tens\u00e3o L1-L2</li><li>Tens\u00e3o L2: Valor eficaz da tens\u00e3o L2-L3</li><li>Tens\u00e3o L3: Valor eficaz da tens\u00e3o L3-L1</li><li>Flicker Plt L1: Flicker Plt L1-L2</li><li>Flicker Plt L2: Flicker Plt L2-L3</li><li>Flicker Plt L3: Flicker Plt L3-L1</li><li>THD L1: Distor\u00e7\u00e3o harm\u00f3nica total THD L1-L2</li><li>THD L2: Distor\u00e7\u00e3o harm\u00f3nica total THD L2-L3</li><li>THD L3: Distor\u00e7\u00e3o harm\u00f3nica total THD L3-L1</li></ul><p>Se for PTD:</p><ul><li>Tens\u00e3o L1: Valor eficaz da tens\u00e3o L1-N</li><li>Tens\u00e3o L2: Valor eficaz da tens\u00e3o L2-N</li><li>Tens\u00e3o L3: Valor eficaz da tens\u00e3o L3-N</li><li>Flicker Plt L1: Flicker Plt L1-N</li><li>Flicker Plt L2: Flicker Plt L2-N</li><li>Flicker Plt L3: Flicker Plt L3-N</li><li>THD L1: Distor\u00e7\u00e3o harm\u00f3nica total THD L1-N</li><li>THD L2: Distor\u00e7\u00e3o harm\u00f3nica total THD L2-N</li><li>THD L3: Distor\u00e7\u00e3o harm\u00f3nica total THD L3-N</li></ul><p>Os dados s\u00e3o atualizados anualmente.</p><p>Estes dados resultam da aplica\u00e7\u00e3o de sucessivos planos bianuais de monitoriza\u00e7\u00e3o de um conjunto de pontos selecionados da rede de distribui\u00e7\u00e3o. A sele\u00e7\u00e3o dos pontos tem em considera\u00e7\u00e3o uma distribui\u00e7\u00e3o geogr\u00e1fica equilibrada, bem como a identifica\u00e7\u00e3o de clientes como sendo mais suscet\u00edveis a varia\u00e7\u00f5es da qualidade de tens\u00e3o, de acordo com o RQS.</p><p><br></p><p>1. A Informa\u00e7\u00e3o disponibilizada pela E-REDES constitui uma aproxima\u00e7\u00e3o aos valores relativos \u00e0s subesta\u00e7\u00f5es e rede MT conforme s\u00e3o retirados dos sistemas e t\u00eam por refer\u00eancia o momento em que a informa\u00e7\u00e3o \u00e9 recolhida.\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0\u00a0</p><p>2. Atendendo a que os pontos de liga\u00e7\u00e3o, a rede de distribui\u00e7\u00e3o de eletricidade, e os pr\u00f3prios valores de consumo e de produ\u00e7\u00e3o s\u00e3o naturalmente muito din\u00e2micos, salvaguarda-se que a informa\u00e7\u00e3o disponibilizada poder\u00e1 ser objeto de subsequentes altera\u00e7\u00f5es e atualiza\u00e7\u00f5es, ficando igualmente ressalvadas eventuais omiss\u00f5es e/ou pontuais imprecis\u00f5es de localiza\u00e7\u00e3o que a informa\u00e7\u00e3o poder\u00e1 conter.</p><p>3. A informa\u00e7\u00e3o disponibilizada pela E-REDES consiste apenas numa aproxima\u00e7\u00e3o quanto \u00e0 capacidade dispon\u00edvel das redes, a cada momento, pelo que n\u00e3o consubstancia uma proposta contratual, nem dispensa a consulta da E-REDES para efeitos da formula\u00e7\u00e3o dos habituais pedidos de liga\u00e7\u00e3o \u00e0 rede (PLR).</p><p>4. A E-REDES salvaguarda que a informa\u00e7\u00e3o disponibilizada n\u00e3o vincula \u00e0 liga\u00e7\u00e3o a qualquer ponto ou ativo espec\u00edfico da rede, ou sequer a uma solu\u00e7\u00e3o espec\u00edfica no \u00e2mbito dos PLR que venham a ser colocados, reservando-se a E-REDES a avaliar caso a caso, em face dos respetivos pedidos, a solu\u00e7\u00e3o t\u00e9cnica que seja a mais adequada, de acordo com os princ\u00edpios a que est\u00e1 legalmente obrigada.</p><p>5. A E-REDES n\u00e3o se responsabiliza perante terceiros, nomeadamente, parceiros, prestadores de servi\u00e7os, empreiteiros, utentes e clientes, pelos danos que possam surgir em consequ\u00eancia, direta ou indireta, do uso da presente Informa\u00e7\u00e3o, em particular aquando da realiza\u00e7\u00e3o de interven\u00e7\u00f5es, c\u00e1lculos e/ou estimativas, sem confirma\u00e7\u00e3o da exatid\u00e3o e atualiza\u00e7\u00e3o dos dados, pelo que devidamente se ressalva de que a consulta da presente informa\u00e7\u00e3o n\u00e3o prejudica o dever de se promover uma consulta direta \u00e0 E-REDES para obter informa\u00e7\u00e3o atualizada.</p><p>6. A informa\u00e7\u00e3o disponibilizada \u00e9, para os devidos efeitos legais, propriedade da E-REDES, n\u00e3o devendo ser copiada, reproduzida, adaptada, modificada, alterada, apagada, destru\u00edda, difundida, transmitida, divulgada ou por qualquer outra forma ser colocada \u00e0 disposi\u00e7\u00e3o de terceiros, sem que para tal tenha sido expressamente validada pela E-REDES. A sua reprodu\u00e7\u00e3o, comercializa\u00e7\u00e3o ou ced\u00eancia a terceiros, mesmo que a t\u00edtulo gratuito, fora dos pressupostos indicados ou sem autoriza\u00e7\u00e3o expressa da E-REDES \u00e9 interdita nos termos legais aplic\u00e1veis e poder\u00e1 implicar responsabilidade civil e criminal.\u00a0</p><p><br></p><p>Os dados fornecidos pelo Portal Open Data da E-REDES s\u00e3o abrangidos por licen\u00e7as abertas (CC BY 4.0). N\u00e3o existem restri\u00e7\u00f5es ao seu acesso, sob o compromisso de os utilizadores dos dados citarem o publicador. Assim, sugerimos que cite o Portal Open Data E-REDES como:</p><p>E-REDES \u2013 Distribui\u00e7\u00e3o de eletricidade, \u201cPortal Open Data E-REDES\u201d. Acedido em \u201cData\u201d. [Online] Dispon\u00edvel em https://e-redes.opendatasoft.com/pages/homepage/</p><p>Se partilhar nas redes sociais, por favor acrescente #PortalOpenData_E_REDES</p>", "theme": ["Operation and Quality of Service"], "theme_en": ["Operation and Quality of Service"], "theme_pt": ["Opera\u00e7\u00e3o e Qualidade de Servi\u00e7o"], "keyword": null, "keyword_en": null, "keyword_pt": null, "license": "CC BY 4.0", "license_en": "CC BY 4.0", "license_pt": "CC BY 4.0", "license_url": "https://creativecommons.org/licenses/by/4.0/", "license_url_en": "https://creativecommons.org/licenses/by/4.0/", "license_url_pt": "https://creativecommons.org/licenses/by/4.0/", "language": "pt", "modified": "2025-06-22T16:54:58+00:00", "publisher": "E-REDES", "publisher_en": "E-REDES", "publisher_pt": "E-REDES", "references": null, "attributions": null, "update_frequency": null, "bbox": null, "data_processed": "2025-09-16T13:31:07+00:00", "federated": false, "geographic_reference": null, "geographic_reference_auto": false, "geometry_types": null, "metadata_languages": ["pt", "en"], "metadata_processed": "2026-09-03T09:56:17.560000+00:00", "modified_updates_on_data_change": false, "modified_updates_on_metadata_change": false, "parent_domain": null, "records_count": 5860, "shared_catalog": null, "source_dataset": null, "source_domain": null, "source_domain_address": null, "source_domain_title": null, "territory": null, "timezone": null}, "custom": {"perfis-de-utilizacao": null, "atualizado": null}}}, {"visibility": "domain", "fields": [{"name": "data", "description": null, "annotations": {"timeserie_precision": "month"}, "label": "Date", "type": "date", "label_en": "Date", "label_pt": "Data", "description_en": null, "description_pt": null}, {"name": "ano", "description": null, "annotations": {}, "label": "Year", "type": "text", "label_en": "Year", "label_pt": "Ano", "description_en": null, "description_pt": null}, {"name": "mes", "description": null, "annotations": {}, "label": "Month", "type": "text", "label_en": "Month", "label_pt": "M\u00eas", "description_en": null, "description_pt": null}, {"name": "dis_name", "description": null, "annotations": {}, "label": "District", "type": "text", "label_en": "District", "label_pt": "Distrito", "description_en": null, "description_pt": null}, {"name": "con_name", "description": null, "annotations": {}, "label": "Municipality", "type": "text", "label_en": "Municipality", "label_pt": "Concelho", "description_en": null, "description_pt": null}, {"name": "fre_name", "description": null, "annotations": {}, "label": "Parish", "type": "text", "label_en": "Parish", "label_pt": "Freguesia", "description_en": null, "description_pt": null}, {"name": "potencia_contratada", "description": null, "annotations": {}, "label": "Contracted Power", "type": "double", "label_en": "Contracted Power", "label_pt": "Pot\u00eancia Contratada", "description_en": null, "description_pt": null}, {"name": "numero_de_contratos", "description": null, "annotations": {}, "label": "Number of Contracts", "type": "double", "label_en": "Number of Contracts", "label_pt": "N\u00famero de Contratos", "description_en": null, "description_pt": null}, {"name": "dis_code", "description": null, "annotations": {}, "label": "District Code", "type": "text", "label_en": "District Code", "label_pt": "C\u00f3digo Distrito", "description_en": null, "description_pt": null}, {"name": "con_code", "description": null, "annotations": {}, "label": "Municipality Code", "type": "text", "label_en": "Municipality Code", "label_pt": "C\u00f3digo Concelho", "description_en": null, "description_pt": null}, {"name": "fre_code", "description": null, "annotations": {}, "label": "Parish Code", "type": "text", "label_en": "Parish Code", "label_pt": "C\u00f3digo Freguesia", "description_en": null, "description_pt": null}], "dataset_id": "potencia-contratada-contratos-ativos-municipio", "dataset_uid": "da_lhz6kh", "has_records": true, "features": ["timeserie", "analyze", "custom_view"], "attachments": [], "alternative_exports": [], "data_visible": true, "metas": {"default": {"title": "Contracted Power", "title_en": "Contracted Power", "title_pt": "Pot\u00eancia contratada", "description": "<p>This dataset presents the contracted power capacity and the corresponding number of active contracts within the electricity distribution network operated by E-REDES, aggregated by district, municipality, and parish.</p><p>The data makes it possible to characterize the contracted power installed in each territory and relate it to the number of associated contracts, enabling the analysis of electrification intensity and the average contract size in each geographic location.</p><p>It allows the monthly monitoring of both contracted power and the number of contracts, supporting studies on the planning and reinforcement of the electricity network, as well as the characterization of potential electricity consumption associated with each territory.</p><p><br></p><p><b>Use cases:</b></p><ul><li>Network electrification.</li><li>Analysis of contracted power by district, municipality, and parish.</li><li>Monitoring the monthly evolution of the number of contracts and contracted power.</li><li>Support for the planning, sizing, and reinforcement of the electricity distribution network.</li><li>Identification of areas with a higher density of contracts or contracted power.</li></ul><p><br></p><p><br></p><p><b>Update frequency:</b> monthly</p><p><br></p><p><b>Included variables:</b></p><ul><li>Year/Month \u2014 Reference period of the information, in year and month format.</li><li>District \u2014 Name of the district where the contracts are located.</li><li>District Code \u2014 Identification code of the district.</li><li>Municipality \u2014 Name of the municipality where the contracts are located.</li><li>Municipality Code \u2014 Identification code of the municipality.</li><li>Parish \u2014 Name of the parish where the contracts are located.</li><li>Parish Code \u2014 Identification code of the parish.</li><li>Contracted Power \u2014 Total contracted power associated with active contracts within the territory under analysis.</li><li>Number of Contracts \u2014 Number of active contracts associated with the territory under analysis.</li></ul><p><br></p><p><br></p><p>1. The information made available by E-REDES is an approximation of the values extracted from its systems and reflects the moment at which the data was collected. As connection points, the electricity distribution network, and consumption and generation values are naturally highly dynamic, E-REDES notes that the information provided may be subject to subsequent changes and updates. Possible omissions and/or occasional location inaccuracies may also exist in the data.</p><p><br></p><p>2. Accordingly, E-REDES shall not be held liable towards third parties, including partners, service providers, contractors, users, and customers, for any damages arising directly or indirectly from the use of this information, particularly when carrying out interventions, calculations, and/or estimates without verifying the accuracy and timeliness of the data. It is therefore expressly stated that consulting this information does not remove the obligation to contact E-REDES directly in order to obtain updated information.</p><p><br></p><p>The data provided through the E-REDES Open Data Portal is covered by open licenses (CC BY 4.0). There are no restrictions on access, provided that users cite the publisher. We therefore suggest the following citation:</p><p><br></p><p>E-REDES \u2013 Electricity Distribution, \u201cE-REDES Open Data Portal\u201d. Accessed on \u201cDate\u201d. \\[Online] Available at: &lt;https://e-redes.opendatasoft.com/pages/homepage/&gt;</p><p><br></p><p>If you share content on social media, please add #PortalOpenData\\_E\\_REDES.</p><p><br></p>", "description_en": "<p>This dataset presents the contracted power capacity and the corresponding number of active contracts within the electricity distribution network operated by E-REDES, aggregated by district, municipality, and parish.</p><p>The data makes it possible to characterize the contracted power installed in each territory and relate it to the number of associated contracts, enabling the analysis of electrification intensity and the average contract size in each geographic location.</p><p>It allows the monthly monitoring of both contracted power and the number of contracts, supporting studies on the planning and reinforcement of the electricity network, as well as the characterization of potential electricity consumption associated with each territory.</p><p><br></p><p><b>Use cases:</b></p><ul><li>Network electrification.</li><li>Analysis of contracted power by district, municipality, and parish.</li><li>Monitoring the monthly evolution of the number of contracts and contracted power.</li><li>Support for the planning, sizing, and reinforcement of the electricity distribution network.</li><li>Identification of areas with a higher density of contracts or contracted power.</li></ul><p><br></p><p><br></p><p><b>Update frequency:</b> monthly</p><p><br></p><p><b>Included variables:</b></p><ul><li>Year/Month \u2014 Reference period of the information, in year and month format.</li><li>District \u2014 Name of the district where the contracts are located.</li><li>District Code \u2014 Identification code of the district.</li><li>Municipality \u2014 Name of the municipality where the contracts are located.</li><li>Municipality Code \u2014 Identification code of the municipality.</li><li>Parish \u2014 Name of the parish where the contracts are located.</li><li>Parish Code \u2014 Identification code of the parish.</li><li>Contracted Power \u2014 Total contracted power associated with active contracts within the territory under analysis.</li><li>Number of Contracts \u2014 Number of active contracts associated with the territory under analysis.</li></ul><p><br></p><p><br></p><p>1. The information made available by E-REDES is an approximation of the values extracted from its systems and reflects the moment at which the data was collected. As connection points, the electricity distribution network, and consumption and generation values are naturally highly dynamic, E-REDES notes that the information provided may be subject to subsequent changes and updates. Possible omissions and/or occasional location inaccuracies may also exist in the data.</p><p><br></p><p>2. Accordingly, E-REDES shall not be held liable towards third parties, including partners, service providers, contractors, users, and customers, for any damages arising directly or indirectly from the use of this information, particularly when carrying out interventions, calculations, and/or estimates without verifying the accuracy and timeliness of the data. It is therefore expressly stated that consulting this information does not remove the obligation to contact E-REDES directly in order to obtain updated information.</p><p><br></p><p>The data provided through the E-REDES Open Data Portal is covered by open licenses (CC BY 4.0). There are no restrictions on access, provided that users cite the publisher. We therefore suggest the following citation:</p><p><br></p><p>E-REDES \u2013 Electricity Distribution, \u201cE-REDES Open Data Portal\u201d. Accessed on \u201cDate\u201d. \\[Online] Available at: &lt;https://e-redes.opendatasoft.com/pages/homepage/&gt;</p><p><br></p><p>If you share content on social media, please add #PortalOpenData\\_E\\_REDES.</p><p><br></p>", "description_pt": "<p>Este dataset apresenta a pot\u00eancia contratada e o respetivo n\u00famero de contratos ativos na rede de distribui\u00e7\u00e3o operada pela E-REDES, agregados por distrito, concelho e freguesia.\u00a0</p><p>Os dados permitem caracterizar a pot\u00eancia contratada instalada em cada territ\u00f3rio, relacionando-a com o n\u00famero de contratos associados, o que possibilita analisar a intensidade de eletrifica\u00e7\u00e3o e a dimens\u00e3o m\u00e9dia dos contratos em cada localiza\u00e7\u00e3o geogr\u00e1fica.\u00a0</p><p>Permite acompanhar a evolu\u00e7\u00e3o mensal da pot\u00eancia contratada e do n\u00famero de contratos, apoiando estudos sobre o dimensionamento e refor\u00e7o da rede el\u00e9trica, bem como a caracteriza\u00e7\u00e3o do consumo potencial associado a cada territ\u00f3rio.\u00a0</p><p><br></p><p><b>Casos de uso:</b></p><ul><li>Eletrifica\u00e7\u00e3o da rede.</li><li>An\u00e1lise da pot\u00eancia contratada por distrito, concelho e freguesia.</li><li>Acompanhamento da evolu\u00e7\u00e3o mensal do n\u00famero de contratos e da pot\u00eancia contratada.</li><li>Apoio ao planeamento, dimensionamento e refor\u00e7o da rede el\u00e9trica.</li><li>Identifica\u00e7\u00e3o de zonas com maior densidade de contratos ou pot\u00eancia contratada.</li></ul><p><br></p><p><b>Periodicidade de atualiza\u00e7\u00e3o: </b>mensal</p><p><br></p><p><b>Vari\u00e1veis inclu\u00eddas:</b></p><ul><li><b>Ano/M\u00eas</b> \u2014 Per\u00edodo de refer\u00eancia da informa\u00e7\u00e3o, no formato ano e m\u00eas.</li><li><b>Distrito </b>\u2014 Nome do distrito onde se localizam os contratos.</li><li><b>C\u00f3digo Distrito</b> \u2014 C\u00f3digo identificativo do distrito.</li><li><b>Concelho </b>\u2014 Nome do concelho onde se localizam os contratos.</li><li><b>C\u00f3digo Concelho</b> \u2014 C\u00f3digo identificativo do concelho.</li><li><b>Freguesia </b>\u2014 Nome da freguesia onde se localizam os contratos.</li><li><b>C\u00f3digo Freguesia</b> \u2014 C\u00f3digo identificativo da freguesia.</li><li><b>Pot\u00eancia Contratada</b> \u2014 Soma da pot\u00eancia contratada nos contratos ativos, associada ao territ\u00f3rio em an\u00e1lise.</li><li><b>N\u00famero de Contratos</b> \u2014 Quantidade de contratos ativos associados ao territ\u00f3rio em an\u00e1lise.</li></ul><p><br></p><p><br></p><p>1. A Informa\u00e7\u00e3o disponibilizada pela E-REDES constitui uma aproxima\u00e7\u00e3o aos valores retirados de sistema e tem por refer\u00eancia o momento em que a mesma \u00e9 recolhida. Atendendo a que os pontos de liga\u00e7\u00e3o, a rede de distribui\u00e7\u00e3o de eletricidade, e os pr\u00f3prios valores de consumo e de produ\u00e7\u00e3o s\u00e3o naturalmente muito din\u00e2micos, salvaguarda-se que a informa\u00e7\u00e3o disponibilizada poder\u00e1 ser objeto de subsequentes altera\u00e7\u00f5es e atualiza\u00e7\u00f5es, ficando igualmente ressalvadas eventuais omiss\u00f5es e/ou pontuais imprecis\u00f5es de localiza\u00e7\u00e3o que a informa\u00e7\u00e3o poder\u00e1 conter.</p><p><br></p><p>2. Desta forma a E-REDES n\u00e3o se responsabiliza perante terceiros, nomeadamente, parceiros, prestadores de servi\u00e7os, empreiteiros, utentes e clientes, pelos danos que possam surgir em consequ\u00eancia, direta ou indireta, do uso da presente Informa\u00e7\u00e3o, em particular aquando da realiza\u00e7\u00e3o de interven\u00e7\u00f5es, c\u00e1lculos e/ou estimativas, sem confirma\u00e7\u00e3o da exatid\u00e3o e atualiza\u00e7\u00e3o dos dados, pelo que devidamente se ressalva de que a consulta da presente informa\u00e7\u00e3o n\u00e3o prejudica o dever de se promover uma consulta direta \u00e0 E-REDES para obter informa\u00e7\u00e3o atualizada.</p><p><br></p><p><br></p><p>Os dados fornecidos pelo Portal Open Data da E-REDES s\u00e3o abrangidos por licen\u00e7as abertas (CC BY 4.0). N\u00e3o existem restri\u00e7\u00f5es ao seu acesso, sob o compromisso de os utilizadores dos dados citarem o publicador. Assim, sugerimos que cite o Portal Open Data E-REDES como:</p><p><br></p><p>E-REDES \u2013 Distribui\u00e7\u00e3o de eletricidade, \u201cPortal Open Data E-REDES\u201d. Acedido em \u201cData\u201d. [Online] Dispon\u00edvel em https://e-redes.opendatasoft.com/pages/homepage/</p><p><br></p><p>Se partilhar nas redes sociais, por favor acrescente #PortalOpenData_E_REDES</p>", "theme": ["Consumption and Energy"], "theme_en": ["Consumption and Energy"], "theme_pt": ["Consumos e Energia"], "keyword": null, "keyword_en": null, "keyword_pt": null, "license": "CC BY 4.0", "license_en": "CC BY 4.0", "license_pt": "CC BY 4.0", "license_url": "https://creativecommons.org/licenses/by/4.0/", "license_url_en": "https://creativecommons.org/licenses/by/4.0/", "license_url_pt": "https://creativecommons.org/licenses/by/4.0/", "language": "pt", "modified": "2026-10-17T02:06:50+00:00", "publisher": "E-REDES", "publisher_en": "E-REDES", "publisher_pt": "E-REDES", "references": null, "attributions": null, "update_frequency": "MONTHLY", "bbox": null, "data_processed": "2026-10-17T02:06:50+00:00", "federated": false, "geographic_reference": null, "geographic_reference_auto": false, "geometry_types": null, "metadata_languages": ["pt", "en"], "metadata_processed": "2026-10-17T02:06:50.688000+00:00", "modified_updates_on_data_change": true, "modified_updates_on_metadata_change": false, "parent_domain": null, "records_count": 130715, "shared_catalog": null, "source_dataset": null, "source_domain": null, "source_domain_address": null, "source_domain_title": null, "territory": null, "timezone": "Europe/Lisbon"}, "custom": {"perfis-de-utilizacao": null, "atualizado": null}}}, {"visibility": "domain", "fields": [{"name": "ano", "description": null, "annotations": {"facet": true}, "label": "Year", "type": "text", "label_en": "Year", "label_pt": "Ano", "description_en": null, "description_pt": null}, {"name": "mes", "description": null, "annotations": {}, "label": "Month", "type": "text", "label_en": "Month", "label_pt": "M\u00eas", "description_en": null, "description_pt": null}, {"name": "con_name", "description": null, "annotations": {}, "label": "Municipality", "type": "text", "label_en": "Municipality", "label_pt": "Concelho", "description_en": null, "description_pt": null}, {"name": "cod_concelho", "description": null, "annotations": {}, "label": "Municipality Code", "type": "text", "label_en": "Municipality Code", "label_pt": "C\u00f3digo Concelho", "description_en": null, "description_pt": null}, {"name": "potencia_ligacao", "description": null, "annotations": {}, "label": "connection power", "type": "text", "label_en": "connection power", "label_pt": "Pot\u00eancia de Liga\u00e7\u00e3o", "description_en": null, "description_pt": null}, {"name": "pedidos_ligacao_rede_executados_nr", "description": null, "annotations": {}, "label": "Network connection requests executed", "type": "int", "label_en": "Network connection requests executed", "label_pt": "Pedidos de liga\u00e7\u00e3o \u00e0 rede executados", "description_en": null, "description_pt": null}], "dataset_id": "25-plr-producao-renovavel", "dataset_uid": "da_7pzaeq", "has_records": true, "features": ["analyze"], "attachments": [], "alternative_exports": [], "data_visible": true, "metas": {"default": {"title": "New connections to the network of power generation centers", "title_en": "New connections to the network of power generation centers", "title_pt": "Novas liga\u00e7\u00f5es \u00e0 rede de centros electroprodutores", "description": "<p>Number of requests executed for grid connection and connection power for new Renewable Production Units per municipality. Monthly value.</p><p>Includes UPAC with power greater than 1MW.</p><p><br></p><p>1. The information made available by E-REDES constitutes an approximation to the values taken from the system and is based on the moment in which it is collected. Given that the connection points, the electricity distribution network, and the consumption and production values themselves are naturally very dynamic, it is safeguarded that the information made available may be subject to subsequent changes and updates, with the exception of any omissions and/or occasional inaccuracies of location that the information may contain.<br></p><p>2. In this way, E-REDES is not liable to third parties, namely, partners, service providers, contractors, users and customers, for damages that may arise as a result, direct or indirect, of the use of this Information, in particular when carrying out interventions, calculations and/or estimates, without confirming the accuracy and updating of the data, whereby it is duly noted that the consultation of this information does not affect the duty to promote a direct consultation with E-REDES in order to obtain updated information.</p><p><br></p><p><span style=\"font-size: inherit;\">The data provided by the E-REDES Open Data Portal is covered by open licenses (CC BY 4.0). There are no restrictions on access, under the commitment that data users cite the publisher.\u00a0Therefore, we suggest that you cite the Open Data E-REDES Portal as:</span></p><p><span style=\"font-size: inherit;\">E-REDES \u2013 Distribui\u00e7\u00e3o de Eletricidade, \u201cE-REDES Open Data Portal\u201d. Accessed in \u201cData\u201d. [Online] Available at </span><a aria-label=\"Link https://e-redes.opendatasoft.com/pages/homepage/\" class=\"fui-Link ___1rxvrpe f2hkw1w f3rmtva f1ewtqcl fyind8e f1k6fduh f1w7gpdv fk6fouc fjoy568 figsok6 f1hu3pq6 f11qmguv f19f4twv f1tyq0we f1g0x7ka fhxju0i f1qch9an f1cnd47f fqv5qza f1vmzxwi f1o700av f13mvf36 f1cmlufx f9n3di6 f1ids18y f1tx3yz7 f1deo86v f1eh06m1 f1iescvh fhgqx19 f1olyrje f1p93eir f1nev41a f1h8hb77 f1lqvz6u f10aw75t fsle3fq f17ae5zn\" href=\"https://e-redes.opendatasoft.com/pages/homepage/\" rel=\"noreferrer noopener\" target=\"_blank\" title=\"https://e-redes.opendatasoft.com/pages/homepage/\"><span style=\"font-size: inherit;\">https://e-redes.opendatasoft.com/pages/homepage/</span></a></p><p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;\"><span lang=\"EN-US\" style=\"font-size: 10.5pt; font-family: Arial, sans-serif;\"><o:p><span class=\"ui-provider a b c d e f g h i j k l m n o p q r s t u v w x y z ab ac ae af ag ah ai aj ak\" dir=\"ltr\"></span></o:p></span></p><p class=\"\"><span style=\"font-size: inherit;\">If you share on social media, please add #PortalOpenData_E_REDES</span></p><p><span style=\"font-size: inherit;\"><br></span></p>", "description_en": "<p>Number of requests executed for grid connection and connection power for new Renewable Production Units per municipality. Monthly value.</p><p>Includes UPAC with power greater than 1MW.</p><p><br></p><p>1. The information made available by E-REDES constitutes an approximation to the values taken from the system and is based on the moment in which it is collected. Given that the connection points, the electricity distribution network, and the consumption and production values themselves are naturally very dynamic, it is safeguarded that the information made available may be subject to subsequent changes and updates, with the exception of any omissions and/or occasional inaccuracies of location that the information may contain.<br></p><p>2. In this way, E-REDES is not liable to third parties, namely, partners, service providers, contractors, users and customers, for damages that may arise as a result, direct or indirect, of the use of this Information, in particular when carrying out interventions, calculations and/or estimates, without confirming the accuracy and updating of the data, whereby it is duly noted that the consultation of this information does not affect the duty to promote a direct consultation with E-REDES in order to obtain updated information.</p><p><br></p><p><span style=\"font-size: inherit;\">The data provided by the E-REDES Open Data Portal is covered by open licenses (CC BY 4.0). There are no restrictions on access, under the commitment that data users cite the publisher.\u00a0Therefore, we suggest that you cite the Open Data E-REDES Portal as:</span></p><p><span style=\"font-size: inherit;\">E-REDES \u2013 Distribui\u00e7\u00e3o de Eletricidade, \u201cE-REDES Open Data Portal\u201d. Accessed in \u201cData\u201d. [Online] Available at </span><a aria-label=\"Link https://e-redes.opendatasoft.com/pages/homepage/\" class=\"fui-Link ___1rxvrpe f2hkw1w f3rmtva f1ewtqcl fyind8e f1k6fduh f1w7gpdv fk6fouc fjoy568 figsok6 f1hu3pq6 f11qmguv f19f4twv f1tyq0we f1g0x7ka fhxju0i f1qch9an f1cnd47f fqv5qza f1vmzxwi f1o700av f13mvf36 f1cmlufx f9n3di6 f1ids18y f1tx3yz7 f1deo86v f1eh06m1 f1iescvh fhgqx19 f1olyrje f1p93eir f1nev41a f1h8hb77 f1lqvz6u f10aw75t fsle3fq f17ae5zn\" href=\"https://e-redes.opendatasoft.com/pages/homepage/\" rel=\"noreferrer noopener\" target=\"_blank\" title=\"https://e-redes.opendatasoft.com/pages/homepage/\"><span style=\"font-size: inherit;\">https://e-redes.opendatasoft.com/pages/homepage/</span></a></p><p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;\"><span lang=\"EN-US\" style=\"font-size: 10.5pt; font-family: Arial, sans-serif;\"><o:p><span class=\"ui-provider a b c d e f g h i j k l m n o p q r s t u v w x y z ab ac ae af ag ah ai aj ak\" dir=\"ltr\"></span></o:p></span></p><p class=\"\"><span style=\"font-size: inherit;\">If you share on social media, please add #PortalOpenData_E_REDES</span></p><p><span style=\"font-size: inherit;\"><br></span></p>", "description_pt": "<p>N\u00famero de pedidos executados de liga\u00e7\u00e3o \u00e0 rede e pot\u00eancia de liga\u00e7\u00e3o para novas Unidades de Produ\u00e7\u00e3o Renov\u00e1vel por concelho. Valor mensal</p><p>Inclui UPAC com pot\u00eancia superior a 1MW.</p><p><br></p><p>1. A Informa\u00e7\u00e3o disponibilizada pela E-REDES constitui uma aproxima\u00e7\u00e3o aos valores retirados de sistema e tem por refer\u00eancia o momento em que a mesma \u00e9 recolhida. Atendendo a que os pontos de liga\u00e7\u00e3o, a rede de distribui\u00e7\u00e3o de eletricidade, e os pr\u00f3prios valores de consumo e de produ\u00e7\u00e3o s\u00e3o naturalmente muito din\u00e2micos, salvaguarda-se que a informa\u00e7\u00e3o disponibilizada poder\u00e1 ser objeto de subsequentes altera\u00e7\u00f5es e atualiza\u00e7\u00f5es, ficando igualmente ressalvadas eventuais omiss\u00f5es e/ou pontuais imprecis\u00f5es de localiza\u00e7\u00e3o que a informa\u00e7\u00e3o poder\u00e1 conter.</p><p>2. Desta forma a E-REDES n\u00e3o se responsabiliza perante terceiros, nomeadamente, parceiros, prestadores de servi\u00e7os, empreiteiros, utentes e clientes, pelos danos que possam surgir em consequ\u00eancia, direta ou indireta, do uso da presente Informa\u00e7\u00e3o, em particular aquando da realiza\u00e7\u00e3o de interven\u00e7\u00f5es, c\u00e1lculos e/ou estimativas, sem confirma\u00e7\u00e3o da exatid\u00e3o e atualiza\u00e7\u00e3o dos dados, pelo que devidamente se ressalva de que a consulta da presente informa\u00e7\u00e3o n\u00e3o prejudica o dever de se promover uma consulta direta \u00e0 E-REDES para obter informa\u00e7\u00e3o atualizada.</p><p><br></p><p><span style=\"font-size: inherit;\">Os dados fornecidos pelo Portal Open Data da E-REDES s\u00e3o abrangidos por licen\u00e7as abertas (</span><a aria-label=\"Link CC BY 4.0\" class=\"fui-Link ___1rxvrpe f2hkw1w f3rmtva f1ewtqcl fyind8e f1k6fduh f1w7gpdv fk6fouc fjoy568 figsok6 f1hu3pq6 f11qmguv f19f4twv f1tyq0we f1g0x7ka fhxju0i f1qch9an f1cnd47f fqv5qza f1vmzxwi f1o700av f13mvf36 f1cmlufx f9n3di6 f1ids18y f1tx3yz7 f1deo86v f1eh06m1 f1iescvh fhgqx19 f1olyrje f1p93eir f1nev41a f1h8hb77 f1lqvz6u f10aw75t fsle3fq f17ae5zn\" href=\"https://creativecommons.org/licenses/by/4.0/\" rel=\"noreferrer noopener\" target=\"_blank\" title=\"https://creativecommons.org/licenses/by/4.0/\">CC BY 4.0</a><span style=\"font-size: inherit;\">). N\u00e3o existem restri\u00e7\u00f5es ao seu acesso, sob o compromisso de os utilizadores dos dados citarem o publicador. Assim, sugerimos que cite o Portal Open Data E-REDES como:</span></p><p><span style=\"font-size: inherit;\">E-REDES \u2013 Distribui\u00e7\u00e3o de eletricidade, \u201cPortal Open Data E-REDES\u201d. Acedido em \u201cData\u201d. [Online] Dispon\u00edvel em </span><a aria-label=\"Link https://e-redes.opendatasoft.com/pages/homepage/\" class=\"fui-Link ___1rxvrpe f2hkw1w f3rmtva f1ewtqcl fyind8e f1k6fduh f1w7gpdv fk6fouc fjoy568 figsok6 f1hu3pq6 f11qmguv f19f4twv f1tyq0we f1g0x7ka fhxju0i f1qch9an f1cnd47f fqv5qza f1vmzxwi f1o700av f13mvf36 f1cmlufx f9n3di6 f1ids18y f1tx3yz7 f1deo86v f1eh06m1 f1iescvh fhgqx19 f1olyrje f1p93eir f1nev41a f1h8hb77 f1lqvz6u f10aw75t fsle3fq f17ae5zn\" href=\"https://e-redes.opendatasoft.com/pages/homepage/\" rel=\"noreferrer noopener\" target=\"_blank\" title=\"https://e-redes.opendatasoft.com/pages/homepage/\"><span style=\"font-size: inherit;\">https://e-redes.opendatasoft.com/pages/homepage/</span></a></p><p><span class=\"ui-provider a b c d e f g h i j k l m n o p q r s t u v w x y z ab ac ae af ag ah ai aj ak\" dir=\"ltr\"></span></p><p><span style=\"font-size: inherit;\">Se partilhar nas redes sociais, por favor acrescente #PortalOpenData_E_REDES</span></p><p><span style=\"font-size: inherit;\"><br></span></p>", "theme": ["Renewables"], "theme_en": ["Renewables"], "theme_pt": ["Renov\u00e1veis"], "keyword": null, "keyword_en": null, "keyword_pt": null, "license": "CC BY 4.0", "license_en": "CC BY 4.0", "license_pt": "CC BY 4.0", "license_url": "https://creativecommons.org/licenses/by/4.0/", "license_url_en": "https://creativecommons.org/licenses/by/4.0/", "license_url_pt": "https://creativecommons.org/licenses/by/4.0/", "language": "pt", "modified": "2026-09-03T12:37:34+00:00", "publisher": "E-REDES", "publisher_en": "E-REDES", "publisher_pt": "E-REDES", "references": null, "attributions": null, "update_frequency": null, "bbox": null, "data_processed": "2026-11-06T11:30:31+00:00", "federated": false, "geographic_reference": ["world_pt"], "geographic_reference_auto": false, "geometry_types": null, "metadata_languages": ["pt", "en"], "metadata_processed": "2026-11-06T11:30:31.655000+00:00", "modified_updates_on_data_change": false, "modified_updates_on_metadata_change": true, "parent_domain": null, "records_count": 253, "shared_catalog": null, "source_dataset": null, "source_domain": null, "source_domain_address": null, "source_domain_title": null, "territory": ["Portugal"], "timezone": "Europe/Lisbon"}, "custom": {"perfis-de-utilizacao": ["Academia", "Mun\u00edcipio", "Produtor de Energia"], "atualizado": "Semestral"}}}, {"visibility": "domain", "fields": [{"name": "datahora", "description": null, "annotations": {"facetsort": "-count", "timeserie_precision": "hour", "facet": true}, "label": "Date/Time", "type": "datetime", "label_en": "Date/Time", "label_pt": "Data/Hora", "description_en": null, "description_pt": null}, {"name": "codigo_postal", "description": null, "annotations": {"facet": true}, "label": "Zip Code", "type": "text", "label_en": "Zip Code", "label_pt": "C\u00f3digo Postal", "description_en": null, "description_pt": null}, {"name": "consumo", "description": null, "annotations": {"facetsort": "-count"}, "label": "Active Energy (kWh)", "type": "double", "label_en": "Active Energy (kWh)", "label_pt": "Energia ativa (kWh)", "description_en": null, "description_pt": null}, {"name": "dt_consumo", "description": null, "annotations": {"facetsort": "-count", "timeserie_precision": "day"}, "label": "Date", "type": "date", "label_en": "Date", "label_pt": "Data", "description_en": null, "description_pt": null}, {"name": "hr_consumo", "description": null, "annotations": {"facetsort": "-count"}, "label": "Hour", "type": "text", "label_en": "Hour", "label_pt": "Hora", "description_en": null, "description_pt": null}, {"name": "codigo_4", "description": null, "annotations": {}, "label": "4 Digits Zip Code", "type": "text", "label_en": "4 Digits Zip Code", "label_pt": "C\u00f3digo Postal 4 D\u00edgitos", "description_en": null, "description_pt": null}, {"name": "codigo_3", "description": null, "annotations": {}, "label": "3 Digits Zip Code", "type": "text", "label_en": "3 Digits Zip Code", "label_pt": "C\u00f3digo Postal 3 D\u00edgitos", "description_en": null, "description_pt": null}], "dataset_id": "consumoshorariocodigopostal2821a3080", "dataset_uid": "da_rczm5z", "has_records": true, "features": ["analyze", "timeserie"], "attachments": [], "alternative_exports": [], "data_visible": true, "metas": {"default": {"title": "Hourly Consumption by Postal Code (2821 to 3080)", "title_en": "Hourly Consumption by Postal Code (2821 to 3080)", "title_pt": "Consumo Hor\u00e1rio por C\u00f3digo Postal (2821 a 3080)", "description": "<p style=\"font-family: sans-serif;\">This DataSet is built based on load diagrams collected by smart meters. In cases where there are still no meters capable of carrying out these collections, or there is difficulty in communicating with them, a profile of consumption is carried out.</p><p style=\"font-family: sans-serif;\">Consult here the document that systematizes the estimation methodology of the different profiles. (https://www.e-redes.pt/sites/eredes/files/2021-08/DocMetodologico_Perfis.pdf)</p><p style=\"font-family: sans-serif;\">Due to the high volume of data, this dataset presents information regarding a period of thirty days, in a sliding window model, with no history conservation. For a longer temporal analysis, regular data extractions are recommended.</p><p style=\"font-family: sans-serif;\">In accordance with the General Data Protection Regulation (GDPR), it is necessary to aggregate postal codes, which are not available individually, into the \"OUTROS\" set.</p><p style=\"font-family: sans-serif;\"><br/></p><p style=\"font-family: sans-serif;\">1. The information made available by E-REDES constitutes an approximation to the values \u200b\u200btaken from the system and is based on the moment in which it is collected. Given that the connection points, the electricity distribution network, and the consumption and production values \u200b\u200bthemselves are naturally very dynamic, it is safeguarded that the information made available may be subject to subsequent changes and updates, with the exception of any omissions and/or occasional inaccuracies of location that the information may contain.</p><p style=\"font-family: sans-serif;\">2. In this way, E-REDES is not liable to third parties, namely, partners, service providers, contractors, users and customers, for damages that may arise as a result, direct or indirect, of the use of this Information, in particular when carrying out interventions, calculations and/or estimates, without confirming the accuracy and updating of the data, whereby it is duly noted that the consultation of this information does not affect the duty to promote a direct consultation with E-REDES to obtain updated information.</p>", "description_en": "<p style=\"font-family: sans-serif;\">This DataSet is built based on load diagrams collected by smart meters. In cases where there are still no meters capable of carrying out these collections, or there is difficulty in communicating with them, a profile of consumption is carried out.</p><p style=\"font-family: sans-serif;\">Consult here the document that systematizes the estimation methodology of the different profiles. (https://www.e-redes.pt/sites/eredes/files/2021-08/DocMetodologico_Perfis.pdf)</p><p style=\"font-family: sans-serif;\">Due to the high volume of data, this dataset presents information regarding a period of thirty days, in a sliding window model, with no history conservation. For a longer temporal analysis, regular data extractions are recommended.</p><p style=\"font-family: sans-serif;\">In accordance with the General Data Protection Regulation (GDPR), it is necessary to aggregate postal codes, which are not available individually, into the \"OUTROS\" set.</p><p style=\"font-family: sans-serif;\"><br/></p><p style=\"font-family: sans-serif;\">1. The information made available by E-REDES constitutes an approximation to the values \u200b\u200btaken from the system and is based on the moment in which it is collected. Given that the connection points, the electricity distribution network, and the consumption and production values \u200b\u200bthemselves are naturally very dynamic, it is safeguarded that the information made available may be subject to subsequent changes and updates, with the exception of any omissions and/or occasional inaccuracies of location that the information may contain.</p><p style=\"font-family: sans-serif;\">2. In this way, E-REDES is not liable to third parties, namely, partners, service providers, contractors, users and customers, for damages that may arise as a result, direct or indirect, of the use of this Information, in particular when carrying out interventions, calculations and/or estimates, without confirming the accuracy and updating of the data, whereby it is duly noted that the consultation of this information does not affect the duty to promote a direct consultation with E-REDES to obtain updated information.</p>", "description_pt": "<p style=\"font-family: sans-serif;\">Este DataSet \u00e9 constru\u00eddo com base nos diagramas de carga recolhidos pelos contadores inteligentes. Em casos onde n\u00e3o existem ainda contadores com a capacidade de realizar estas recolhas, ou exista dificuldade de comunica\u00e7\u00e3o com os mesmos, \u00e9 realizada uma perfilagem de consumos.</p><p style=\"font-family: sans-serif;\">Consulte aqui o documento que sistematiza a metodologia de estima\u00e7\u00e3o dos diferentes perfis. (https://www.e-redes.pt/sites/eredes/files/2021-08/DocMetodologico_Perfis.pdf)</p><p style=\"font-family: sans-serif;\">Devido ao elevado volume de dados, este dataset apresenta a informa\u00e7\u00e3o relativa a um per\u00edodo de trinta dias, num modelo de janela deslizante, sem conserva\u00e7\u00e3o de hist\u00f3rico. Para an\u00e1lises temporais mais longas, recomenda-se a extra\u00e7\u00e3o regular de dados.</p><p style=\"font-family: sans-serif;\">De acordo com Regulamento Geral de Prote\u00e7\u00e3o de Dados (RGPD), \u00e9 necess\u00e1rio realizar a agrega\u00e7\u00e3o de c\u00f3digos postais, que n\u00e3o est\u00e3o dispon\u00edveis individualmente, no conjunto \"OUTROS\".</p><p style=\"font-family: sans-serif;\"><br></p><p style=\"font-family: sans-serif;\">1. A Informa\u00e7\u00e3o disponibilizada pela E-REDES constitui uma aproxima\u00e7\u00e3o aos valores retirados de sistema e tem por refer\u00eancia o momento em que a mesma \u00e9 recolhida. Atendendo a que os pontos de liga\u00e7\u00e3o, a rede de distribui\u00e7\u00e3o de eletricidade, e os pr\u00f3prios valores de consumo e de produ\u00e7\u00e3o s\u00e3o naturalmente muito din\u00e2micos, salvaguarda-se que a informa\u00e7\u00e3o disponibilizada poder\u00e1 ser objeto de subsequentes altera\u00e7\u00f5es e atualiza\u00e7\u00f5es, ficando igualmente ressalvadas eventuais omiss\u00f5es e/ou pontuais imprecis\u00f5es de localiza\u00e7\u00e3o que a informa\u00e7\u00e3o poder\u00e1 conter.</p><p style=\"font-family: sans-serif;\">2. Desta forma a E-REDES n\u00e3o se responsabiliza perante terceiros, nomeadamente, parceiros, prestadores de servi\u00e7os, empreiteiros, utentes e clientes, pelos danos que possam surgir em consequ\u00eancia, direta ou indireta, do uso da presente Informa\u00e7\u00e3o, em particular aquando da realiza\u00e7\u00e3o de interven\u00e7\u00f5es, c\u00e1lculos e/ou estimativas, sem confirma\u00e7\u00e3o da exatid\u00e3o e atualiza\u00e7\u00e3o dos dados, pelo que devidamente se ressalva de que a consulta da presente informa\u00e7\u00e3o n\u00e3o prejudica o dever de se promover uma consulta direta \u00e0 E-REDES para obter informa\u00e7\u00e3o atualizada.</p>", "theme": ["Consumption and Energy"], "theme_en": ["Consumption and Energy"], "theme_pt": ["Consumos e Energia"], "keyword": ["internal"], "keyword_en": ["internal"], "keyword_pt": ["internal"], "license": "CC BY 4.0", "license_en": "CC BY 4.0", "license_pt": "CC BY 4.0", "license_url": "https://creativecommons.org/licenses/by/4.0/", "license_url_en": "https://creativecommons.org/licenses/by/4.0/", "license_url_pt": "https://creativecommons.org/licenses/by/4.0/", "language": "pt", "modified": "2026-09-03T12:38:07+00:00", "publisher": "E-REDES", "publisher_en": "E-REDES", "publisher_pt": "E-REDES", "references": null, "attributions": null, "update_frequency": null, "bbox": null, "data_processed": "2024-09-25T18:20:36+00:00", "federated": false, "geographic_reference": ["world_pt"], "geographic_reference_auto": false, "geometry_types": null, "metadata_languages": ["pt", "en"], "metadata_processed": "2026-09-03T12:38:08.890000+00:00", "modified_updates_on_data_change": false, "modified_updates_on_metadata_change": true, "parent_domain": null, "records_count": 4211342, "shared_catalog": null, "source_dataset": null, "source_domain": null, "source_domain_address": null, "source_domain_title": null, "territory": ["Portugal"], "timezone": "Europe/London"}, "custom": {"perfis-de-utilizacao": ["Academia", "Developer"], "atualizado": "Mensal"}}}, {"visibility": "domain", "fields": [{"name": "datahora", "description": null, "annotations": {"facetsort": "-count", "timeserie_precision": "hour", "facet": true}, "label": "Date/Time", "type": "datetime", "label_en": "Date/Time", "label_pt": "Data/Hora", "description_en": null, "description_pt": null}, {"name": "codigo_postal", "description": null, "annotations": {"facet": true}, "label": "Zip Code", "type": "text", "label_en": "Zip Code", "label_pt": "C\u00f3digo Postal", "description_en": null, "description_pt": null}, {"name": "consumo", "description": null, "annotations": {"facetsort": "-count"}, "label": "Active Energy (kWh)", "type": "double", "label_en": "Active Energy (kWh)", "label_pt": "Energia ativa (kWh)", "description_en": null, "description_pt": null}, {"name": "dt_consumo", "description": null, "annotations": {"facetsort": "-count", "timeserie_precision": "day"}, "label": "Date", "type": "date", "label_en": "Date", "label_pt": "Data", "description_en": null, "description_pt": null}, {"name": "hr_consumo", "description": null, "annotations": {"facetsort": "-count"}, "label": "Hour", "type": "text", "label_en": "Hour", "label_pt": "Hora", "description_en": null, "description_pt": null}, {"name": "codigo_4", "description": null, "annotations": {}, "label": "4 Digits Zip Code", "type": "text", "label_en": "4 Digits Zip Code", "label_pt": "C\u00f3digo Postal 4 D\u00edgitos", "description_en": null, "description_pt": null}, {"name": "codigo_3", "description": null, "annotations": {}, "label": "3 Digits Zip Code", "type": "text", "label_en": "3 Digits Zip Code", "label_pt": "C\u00f3digo Postal 3 D\u00edgitos", "description_en": null, "description_pt": null}], "dataset_id": "consumoshorariocodigopostal3781a4420", "dataset_uid": "da_i67smh", "has_records": true, "features": ["analyze", "timeserie"], "attachments": [], "alternative_exports": [], "data_visible": true, "metas": {"default": {"title": "Hourly Consumption by Postal Code (3781 to 4420)", "title_en": "Hourly Consumption by Postal Code (3781 to 4420)", "title_pt": "Consumo Hor\u00e1rio por C\u00f3digo Postal (3781 a 4420)", "description": "<p style=\"font-family: sans-serif;\">This DataSet is built based on load diagrams collected by smart meters. In cases where there are still no meters capable of carrying out these collections, or there is difficulty in communicating with them, a profile of consumption is carried out.</p><p style=\"font-family: sans-serif;\">Consult here the document that systematizes the estimation methodology of the different profiles. (https://www.e-redes.pt/sites/eredes/files/2021-08/DocMetodologico_Perfis.pdf)</p><p style=\"font-family: sans-serif;\">Due to the high volume of data, this dataset presents information regarding a period of thirty days, in a sliding window model, with no history conservation. For a longer temporal analysis, regular data extractions are recommended.</p><p style=\"font-family: sans-serif;\">In accordance with the General Data Protection Regulation (GDPR), it is necessary to aggregate postal codes, which are not available individually, into the \"OUTROS\" set.</p><p style=\"font-family: sans-serif;\"><br/></p><p style=\"font-family: sans-serif;\">1. The information made available by E-REDES constitutes an approximation to the values \u200b\u200btaken from the system and is based on the moment in which it is collected. Given that the connection points, the electricity distribution network, and the consumption and production values \u200b\u200bthemselves are naturally very dynamic, it is safeguarded that the information made available may be subject to subsequent changes and updates, with the exception of any omissions and/or occasional inaccuracies of location that the information may contain.</p><p style=\"font-family: sans-serif;\">2. In this way, E-REDES is not liable to third parties, namely, partners, service providers, contractors, users and customers, for damages that may arise as a result, direct or indirect, of the use of this Information, in particular when carrying out interventions, calculations and/or estimates, without confirming the accuracy and updating of the data, whereby it is duly noted that the consultation of this information does not affect the duty to promote a direct consultation with E-REDES to obtain updated information.</p>", "description_en": "<p style=\"font-family: sans-serif;\">This DataSet is built based on load diagrams collected by smart meters. In cases where there are still no meters capable of carrying out these collections, or there is difficulty in communicating with them, a profile of consumption is carried out.</p><p style=\"font-family: sans-serif;\">Consult here the document that systematizes the estimation methodology of the different profiles. (https://www.e-redes.pt/sites/eredes/files/2021-08/DocMetodologico_Perfis.pdf)</p><p style=\"font-family: sans-serif;\">Due to the high volume of data, this dataset presents information regarding a period of thirty days, in a sliding window model, with no history conservation. For a longer temporal analysis, regular data extractions are recommended.</p><p style=\"font-family: sans-serif;\">In accordance with the General Data Protection Regulation (GDPR), it is necessary to aggregate postal codes, which are not available individually, into the \"OUTROS\" set.</p><p style=\"font-family: sans-serif;\"><br/></p><p style=\"font-family: sans-serif;\">1. The information made available by E-REDES constitutes an approximation to the values \u200b\u200btaken from the system and is based on the moment in which it is collected. Given that the connection points, the electricity distribution network, and the consumption and production values \u200b\u200bthemselves are naturally very dynamic, it is safeguarded that the information made available may be subject to subsequent changes and updates, with the exception of any omissions and/or occasional inaccuracies of location that the information may contain.</p><p style=\"font-family: sans-serif;\">2. In this way, E-REDES is not liable to third parties, namely, partners, service providers, contractors, users and customers, for damages that may arise as a result, direct or indirect, of the use of this Information, in particular when carrying out interventions, calculations and/or estimates, without confirming the accuracy and updating of the data, whereby it is duly noted that the consultation of this information does not affect the duty to promote a direct consultation with E-REDES to obtain updated information.</p>", "description_pt": "<p style=\"font-family: sans-serif;\">Este DataSet \u00e9 constru\u00eddo com base nos diagramas de carga recolhidos pelos contadores inteligentes. Em casos onde n\u00e3o existem ainda contadores com a capacidade de realizar estas recolhas, ou exista dificuldade de comunica\u00e7\u00e3o com os mesmos, \u00e9 realizada uma perfilagem de consumos.</p><p style=\"font-family: sans-serif;\">Consulte aqui o documento que sistematiza a metodologia de estima\u00e7\u00e3o dos diferentes perfis. (https://www.e-redes.pt/sites/eredes/files/2021-08/DocMetodologico_Perfis.pdf)</p><p style=\"font-family: sans-serif;\">Devido ao elevado volume de dados, este dataset apresenta a informa\u00e7\u00e3o relativa a um per\u00edodo de trinta dias, num modelo de janela deslizante, sem conserva\u00e7\u00e3o de hist\u00f3rico. Para an\u00e1lises temporais mais longas, recomenda-se a extra\u00e7\u00e3o regular de dados.</p><p style=\"font-family: sans-serif;\">De acordo com Regulamento Geral de Prote\u00e7\u00e3o de Dados (RGPD), \u00e9 necess\u00e1rio realizar a agrega\u00e7\u00e3o de c\u00f3digos postais, que n\u00e3o est\u00e3o dispon\u00edveis individualmente, no conjunto \"OUTROS\".</p><p style=\"font-family: sans-serif;\"><br></p><p style=\"font-family: sans-serif;\">1. A Informa\u00e7\u00e3o disponibilizada pela E-REDES constitui uma aproxima\u00e7\u00e3o aos valores retirados de sistema e tem por refer\u00eancia o momento em que a mesma \u00e9 recolhida. Atendendo a que os pontos de liga\u00e7\u00e3o, a rede de distribui\u00e7\u00e3o de eletricidade, e os pr\u00f3prios valores de consumo e de produ\u00e7\u00e3o s\u00e3o naturalmente muito din\u00e2micos, salvaguarda-se que a informa\u00e7\u00e3o disponibilizada poder\u00e1 ser objeto de subsequentes altera\u00e7\u00f5es e atualiza\u00e7\u00f5es, ficando igualmente ressalvadas eventuais omiss\u00f5es e/ou pontuais imprecis\u00f5es de localiza\u00e7\u00e3o que a informa\u00e7\u00e3o poder\u00e1 conter.</p><p style=\"font-family: sans-serif;\">2. Desta forma a E-REDES n\u00e3o se responsabiliza perante terceiros, nomeadamente, parceiros, prestadores de servi\u00e7os, empreiteiros, utentes e clientes, pelos danos que possam surgir em consequ\u00eancia, direta ou indireta, do uso da presente Informa\u00e7\u00e3o, em particular aquando da realiza\u00e7\u00e3o de interven\u00e7\u00f5es, c\u00e1lculos e/ou estimativas, sem confirma\u00e7\u00e3o da exatid\u00e3o e atualiza\u00e7\u00e3o dos dados, pelo que devidamente se ressalva de que a consulta da presente informa\u00e7\u00e3o n\u00e3o prejudica o dever de se promover uma consulta direta \u00e0 E-REDES para obter informa\u00e7\u00e3o atualizada.</p>", "theme": ["Consumption and Energy"], "theme_en": ["Consumption and Energy"], "theme_pt": ["Consumos e Energia"], "keyword": ["internal"], "keyword_en": ["internal"], "keyword_pt": ["internal"], "license": "CC BY 4.0", "license_en": "CC BY 4.0", "license_pt": "CC BY 4.0", "license_url": "https://creativecommons.org/licenses/by/4.0/", "license_url_en": "https://creativecommons.org/licenses/by/4.0/", "license_url_pt": "https://creativecommons.org/licenses/by/4.0/", "language": "pt", "modified": "2026-09-03T12:38:13+00:00", "publisher": "E-REDES", "publisher_en": "E-REDES", "publisher_pt": "E-REDES", "references": null, "attributions": null, "update_frequency": null, "bbox": null, "data_processed": "2024-09-25T18:13:52+00:00", "federated": false, "geographic_reference": ["world_pt"], "geographic_reference_auto": false, "geometry_types": null, "metadata_languages": ["pt", "en"], "metadata_processed": "2026-09-03T12:38:14.079000+00:00", "modified_updates_on_data_change": false, "modified_updates_on_metadata_change": true, "parent_domain": null, "records_count": 4082326, "shared_catalog": null, "source_dataset": null, "source_domain": null, "source_domain_address": null, "source_domain_title": null, "territory": ["Portugal"], "timezone": "Europe/London"}, "custom": {"perfis-de-utilizacao": ["Academia", "Developer"], "atualizado": "Mensal"}}}, {"visibility": "domain", "fields": [{"name": "data", "description": null, "annotations": {"timeserie_precision": "month"}, "label": "Date", "type": "date", "label_en": "Date", "label_pt": "Data", "description_en": null, "description_pt": null}, {"name": "ano", "description": null, "annotations": {}, "label": "Year", "type": "text", "label_en": "Year", "label_pt": "Ano", "description_en": null, "description_pt": null}, {"name": "mes", "description": null, "annotations": {}, "label": "Month", "type": "text", "label_en": "Month", "label_pt": "M\u00eas", "description_en": null, "description_pt": null}, {"name": "dis_name", "description": null, "annotations": {}, "label": "District ", "type": "text", "label_en": "District ", "label_pt": "Distrito", "description_en": null, "description_pt": null}, {"name": "con_name", "description": null, "annotations": {}, "label": "Municipality", "type": "text", "label_en": "Municipality", "label_pt": "Concelho", "description_en": null, "description_pt": null}, {"name": "fre_name", "description": null, "annotations": {}, "label": "Parish", "type": "text", "label_en": "Parish", "label_pt": "Freguesia", "description_en": null, "description_pt": null}, {"name": "energia_ativa_simples_kwh", "description": null, "annotations": {}, "label": "Active Energy \u2013 Single Rate (kWh)", "type": "double", "label_en": "Active Energy \u2013 Single Rate (kWh)", "label_pt": "Energia Ativa Simples (kWh)", "description_en": null, "description_pt": null}, {"name": "energia_ativa_vazio_kwh", "description": null, "annotations": {}, "label": "Active Energy \u2013 Off\u2011Peak (kWh)", "type": "double", "label_en": "Active Energy \u2013 Off\u2011Peak (kWh)", "label_pt": "Energia Ativa Vazio (kWh)", "description_en": null, "description_pt": null}, {"name": "energia_ativa_fora_de_vazio_kwh", "description": null, "annotations": {}, "label": "Active Energy \u2013 Peak (Non Off\u2011Peak) (kWh)", "type": "double", "label_en": "Active Energy \u2013 Peak (Non Off\u2011Peak) (kWh)", "label_pt": "Energia Ativa Fora de Vazio (kWh)", "description_en": null, "description_pt": null}, {"name": "energia_ativa_super_vazio_kwh", "description": null, "annotations": {}, "label": "Active Energy \u2013 Super Off\u2011Peak (kWh)", "type": "double", "label_en": "Active Energy \u2013 Super Off\u2011Peak (kWh)", "label_pt": "Energia Ativa Super Vazio (kWh)", "description_en": null, "description_pt": null}, {"name": "energia_ativa_ponta_kwh", "description": null, "annotations": {}, "label": "Active Energy \u2013 Peak Period (kWh)", "type": "double", "label_en": "Active Energy \u2013 Peak Period (kWh)", "label_pt": "Energia Ativa Ponta (kWh)", "description_en": null, "description_pt": null}, {"name": "energia_ativa_cheias_kwh", "description": null, "annotations": {}, "label": "Active Energy \u2013 Mid\u2011Peak Period (kWh)", "type": "double", "label_en": "Active Energy \u2013 Mid\u2011Peak Period (kWh)", "label_pt": "Energia Ativa Cheias (kWh)", "description_en": null, "description_pt": null}, {"name": "energia_ativa_total_kwh", "description": null, "annotations": {}, "label": "Total Active Energy (kWh)", "type": "double", "label_en": "Total Active Energy (kWh)", "label_pt": "Energia Ativa Total (kWh)", "description_en": null, "description_pt": null}, {"name": "dis_code", "description": null, "annotations": {}, "label": "District Code", "type": "text", "label_en": "District Code", "label_pt": "C\u00f3digo Distrito", "description_en": null, "description_pt": null}, {"name": "con_code", "description": null, "annotations": {}, "label": "Municipality Code", "type": "text", "label_en": "Municipality Code", "label_pt": "C\u00f3digo Concelho", "description_en": null, "description_pt": null}, {"name": "fre_code", "description": null, "annotations": {}, "label": "Parish Code", "type": "text", "label_en": "Parish Code", "label_pt": "C\u00f3digo Freguesia", "description_en": null, "description_pt": null}], "dataset_id": "consumos-faturados-por-periodo-tarifario", "dataset_uid": "da_88nmgb", "has_records": true, "features": ["timeserie", "analyze", "custom_view"], "attachments": [], "alternative_exports": [], "data_visible": true, "metas": {"default": {"title": "Electricity Consumption by Municipality by Tariff Period", "title_en": "Electricity Consumption by Municipality by Tariff Period", "title_pt": "Consumos por munic\u00edpio por per\u00edodo tarif\u00e1rio", "description": "<p>This dataset presents active electricity consumption by municipality, broken down by tariff period, based on the distribution network operated by E-REDES.</p><p>The data is organized by geographic location (district, municipality and parish) and by tariff period, allowing analysis of energy consumption according to the applicable time-of-use cycle (e.g., off-peak, peak or standard hours).</p><p>Tariff periods reflect the different time intervals defined for electricity tariff purposes, used to distinguish consumption recorded during hours of lower demand (off-peak, super off-peak) from hours of higher demand on the network (peak, standard).</p><p>This dataset makes it possible to characterize energy consumption patterns by territory, identify seasonal and hourly variations in consumption, and support studies related to tariff planning, demand management and energy efficiency.</p><p><br></p><p><b>Use cases:</b></p><ul><li>Tariff analysis by municipality.</li><li>Characterization of energy consumption by time-of-use period (off-peak, non off-peak, super off-peak, peak and standard hours).</li><li>Comparison of consumption patterns between different municipalities and regions.</li><li>Support for demand management and energy efficiency studies.</li><li>Identification of seasonality and monthly variations in energy consumption.</li></ul><p><br></p><p><b>Update frequency:</b> monthly</p><p><br></p><p><b>Variables included:</b></p><ul><li><b>Date </b>\u2014 Reference date of the information.</li><li><b>Year </b>\u2014 Year corresponding to the analysis period.</li><li><b>Month </b>\u2014 Month corresponding to the analysis period.</li><li><b>District </b>\u2014 Name of the district where the recorded consumption is located.</li><li><b>District Code</b> \u2014 Identification code of the district.</li><li><b>Municipality </b>\u2014 Name of the municipality where the recorded consumption is located.</li><li><b>Municipality Code</b> \u2014 Identification code of the municipality.</li><li><b>Parish </b>\u2014 Name of the parish where the recorded consumption is located.</li><li><b>Parish Code</b> \u2014 Identification code of the parish.</li><li><b>Simple Active Energy (kWh)</b> \u2014 Active energy consumption recorded under a simple tariff (with no distinction by time-of-use period).</li><li><b>Off-Peak Active Energy (kWh) </b>\u2014 Active energy consumption recorded during the off-peak period.</li><li><b>Non Off-Peak Active Energy (kWh) </b>\u2014 Active energy consumption recorded during the non off-peak period.</li><li><b>Super Off-Peak Active Energy (kWh) </b>\u2014 Active energy consumption recorded during the super off-peak period.</li><li><b>Peak Active Energy (kWh)</b> \u2014 Active energy consumption recorded during the peak period.</li><li><b>Standard Active Energy (kWh)</b> \u2014 Active energy consumption recorded during the standard (cheias) period.</li><li><b>Total Active Energy (kWh)</b> \u2014 Total active energy consumption, corresponding to the sum of all tariff periods.</li></ul><p><br></p><p>1. The information made available by E-REDES constitutes an approximation of values taken from the system and refers to the moment at which it was collected. Given that connection points, the electricity distribution network, and the consumption and production values themselves are naturally very dynamic, it is noted that the information provided may be subject to subsequent changes and updates, and any omissions and/or occasional location inaccuracies that the information may contain are also reserved.</p><p><br></p><p>2. Accordingly, E-REDES is not liable to third parties, namely partners, service providers, contractors, users and clients, for any damages that may arise as a direct or indirect consequence of the use of this Information, particularly when carrying out interventions, calculations and/or estimates, without confirming the accuracy and update status of the data. It is therefore noted that consulting this information does not exempt users from the duty to consult E-REDES directly to obtain updated information.</p><p><br></p><p>The data provided through the E-REDES Open Data Portal is covered by open licenses (CC BY 4.0). There are no restrictions on access, provided that data users cite the publisher. We therefore suggest citing the E-REDES Open Data Portal as follows:</p><p><br></p><p>E-REDES \u2013 Distribui\u00e7\u00e3o de eletricidade, \"Portal Open Data E-REDES\". Accessed on \"Date\". [Online] Available at https://e-redes.opendatasoft.com/pages/homepage/</p><p><br></p><p>If sharing on social media, please add #PortalOpenData_E_REDES</p>", "description_en": "<p>This dataset presents active electricity consumption by municipality, broken down by tariff period, based on the distribution network operated by E-REDES.</p><p>The data is organized by geographic location (district, municipality and parish) and by tariff period, allowing analysis of energy consumption according to the applicable time-of-use cycle (e.g., off-peak, peak or standard hours).</p><p>Tariff periods reflect the different time intervals defined for electricity tariff purposes, used to distinguish consumption recorded during hours of lower demand (off-peak, super off-peak) from hours of higher demand on the network (peak, standard).</p><p>This dataset makes it possible to characterize energy consumption patterns by territory, identify seasonal and hourly variations in consumption, and support studies related to tariff planning, demand management and energy efficiency.</p><p><br></p><p><b>Use cases:</b></p><ul><li>Tariff analysis by municipality.</li><li>Characterization of energy consumption by time-of-use period (off-peak, non off-peak, super off-peak, peak and standard hours).</li><li>Comparison of consumption patterns between different municipalities and regions.</li><li>Support for demand management and energy efficiency studies.</li><li>Identification of seasonality and monthly variations in energy consumption.</li></ul><p><br></p><p><b>Update frequency:</b> monthly</p><p><br></p><p><b>Variables included:</b></p><ul><li><b>Date </b>\u2014 Reference date of the information.</li><li><b>Year </b>\u2014 Year corresponding to the analysis period.</li><li><b>Month </b>\u2014 Month corresponding to the analysis period.</li><li><b>District </b>\u2014 Name of the district where the recorded consumption is located.</li><li><b>District Code</b> \u2014 Identification code of the district.</li><li><b>Municipality </b>\u2014 Name of the municipality where the recorded consumption is located.</li><li><b>Municipality Code</b> \u2014 Identification code of the municipality.</li><li><b>Parish </b>\u2014 Name of the parish where the recorded consumption is located.</li><li><b>Parish Code</b> \u2014 Identification code of the parish.</li><li><b>Simple Active Energy (kWh)</b> \u2014 Active energy consumption recorded under a simple tariff (with no distinction by time-of-use period).</li><li><b>Off-Peak Active Energy (kWh) </b>\u2014 Active energy consumption recorded during the off-peak period.</li><li><b>Non Off-Peak Active Energy (kWh) </b>\u2014 Active energy consumption recorded during the non off-peak period.</li><li><b>Super Off-Peak Active Energy (kWh) </b>\u2014 Active energy consumption recorded during the super off-peak period.</li><li><b>Peak Active Energy (kWh)</b> \u2014 Active energy consumption recorded during the peak period.</li><li><b>Standard Active Energy (kWh)</b> \u2014 Active energy consumption recorded during the standard (cheias) period.</li><li><b>Total Active Energy (kWh)</b> \u2014 Total active energy consumption, corresponding to the sum of all tariff periods.</li></ul><p><br></p><p>1. The information made available by E-REDES constitutes an approximation of values taken from the system and refers to the moment at which it was collected. Given that connection points, the electricity distribution network, and the consumption and production values themselves are naturally very dynamic, it is noted that the information provided may be subject to subsequent changes and updates, and any omissions and/or occasional location inaccuracies that the information may contain are also reserved.</p><p><br></p><p>2. Accordingly, E-REDES is not liable to third parties, namely partners, service providers, contractors, users and clients, for any damages that may arise as a direct or indirect consequence of the use of this Information, particularly when carrying out interventions, calculations and/or estimates, without confirming the accuracy and update status of the data. It is therefore noted that consulting this information does not exempt users from the duty to consult E-REDES directly to obtain updated information.</p><p><br></p><p>The data provided through the E-REDES Open Data Portal is covered by open licenses (CC BY 4.0). There are no restrictions on access, provided that data users cite the publisher. We therefore suggest citing the E-REDES Open Data Portal as follows:</p><p><br></p><p>E-REDES \u2013 Distribui\u00e7\u00e3o de eletricidade, \"Portal Open Data E-REDES\". Accessed on \"Date\". [Online] Available at https://e-redes.opendatasoft.com/pages/homepage/</p><p><br></p><p>If sharing on social media, please add #PortalOpenData_E_REDES</p>", "description_pt": "<div class=\"OutlineElement Ltr SCXW84946739 BCX8\" style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; user-select: text; clear: both; cursor: text; overflow: visible; position: relative; direction: ltr;\"><p class=\"Paragraph SCXW84946739 BCX8\" paraeid=\"{92b89a3b-a102-4792-b805-cb8152004842}{8}\" paraid=\"679936465\" style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\">Este dataset apresenta os consumos de energia el\u00e9trica ativa por munic\u00edpio, discriminados por per\u00edodo tarif\u00e1rio, com base na rede de distribui\u00e7\u00e3o operada pela E-REDES.</p><p class=\"Paragraph SCXW84946739 BCX8\" paraeid=\"{92b89a3b-a102-4792-b805-cb8152004842}{8}\" paraid=\"679936465\" style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\">Os dados est\u00e3o organizados por localiza\u00e7\u00e3o geogr\u00e1fica (distrito, concelho e freguesia) e por per\u00edodo tarif\u00e1rio, permitindo analisar o consumo de energia consoante o ciclo hor\u00e1rio aplic\u00e1vel (ex.: horas de vazio, ponta ou cheias).</p><p class=\"Paragraph SCXW84946739 BCX8\" paraeid=\"{92b89a3b-a102-4792-b805-cb8152004842}{8}\" paraid=\"679936465\" style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\">Os per\u00edodos tarif\u00e1rios refletem os diferentes intervalos hor\u00e1rios definidos para efeitos de tarifa\u00e7\u00e3o da energia el\u00e9trica, sendo utilizados para distinguir o consumo registado em horas de menor procura (vazio, super vazio) das horas de maior procura na rede (ponta, cheias).</p><p class=\"Paragraph SCXW84946739 BCX8\" paraeid=\"{92b89a3b-a102-4792-b805-cb8152004842}{8}\" paraid=\"679936465\" style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\">Este dataset permite caracterizar os padr\u00f5es de consumo de energia por territ\u00f3rio, identificar varia\u00e7\u00f5es sazonais e hor\u00e1rias de consumo, e apoiar estudos relacionados com o planeamento tarif\u00e1rio, a gest\u00e3o da procura e a efici\u00eancia energ\u00e9tica.</p><p class=\"Paragraph SCXW84946739 BCX8\" paraeid=\"{92b89a3b-a102-4792-b805-cb8152004842}{8}\" paraid=\"679936465\" style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\"><br></p><p class=\"Paragraph SCXW84946739 BCX8\" paraeid=\"{92b89a3b-a102-4792-b805-cb8152004842}{8}\" paraid=\"679936465\" style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\"><b>Casos de uso:</b></p><ul><li style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\">An\u00e1lise tarif\u00e1ria por munic\u00edpio.</li><li style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\">Caracteriza\u00e7\u00e3o do consumo de energia por per\u00edodo hor\u00e1rio (vazio, fora de vazio, super vazio, ponta e cheias).</li><li style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\">Compara\u00e7\u00e3o de padr\u00f5es de consumo entre diferentes munic\u00edpios e regi\u00f5es.</li><li style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\">Apoio a estudos de gest\u00e3o da procura e efici\u00eancia energ\u00e9tica.</li><li style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\">Identifica\u00e7\u00e3o de sazonalidade e varia\u00e7\u00f5es mensais no consumo de energia.</li></ul><p class=\"Paragraph SCXW84946739 BCX8\" paraeid=\"{92b89a3b-a102-4792-b805-cb8152004842}{8}\" paraid=\"679936465\" style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\"><br></p><p class=\"Paragraph SCXW84946739 BCX8\" paraeid=\"{92b89a3b-a102-4792-b805-cb8152004842}{8}\" paraid=\"679936465\" style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\"><b>Periodicidade de atualiza\u00e7\u00e3o: </b>mensal</p><p class=\"Paragraph SCXW84946739 BCX8\" paraeid=\"{92b89a3b-a102-4792-b805-cb8152004842}{8}\" paraid=\"679936465\" style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\"><br></p><p class=\"Paragraph SCXW84946739 BCX8\" paraeid=\"{92b89a3b-a102-4792-b805-cb8152004842}{8}\" paraid=\"679936465\" style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\"><b>Vari\u00e1veis inclu\u00eddas:</b></p><ul><li style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\"><b>Data </b>\u2014 Data de refer\u00eancia da informa\u00e7\u00e3o.</li><li style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\"><b>Ano </b>\u2014 Ano correspondente ao per\u00edodo de an\u00e1lise.</li><li style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\"><b>M\u00eas </b>\u2014 M\u00eas correspondente ao per\u00edodo de an\u00e1lise.</li><li style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\"><b>Distrito</b> \u2014 Nome do distrito onde se localiza o consumo registado.</li><li style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\"><b>C\u00f3digo Distrito</b> \u2014 C\u00f3digo identificativo do distrito.</li><li style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\"><b>Concelho </b>\u2014 Nome do concelho onde se localiza o consumo registado.</li><li style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\"><b>C\u00f3digo Concelho</b> \u2014 C\u00f3digo identificativo do concelho.</li><li style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\"><b>Freguesia </b>\u2014 Nome da freguesia onde se localiza o consumo registado.</li><li style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\"><b>C\u00f3digo Freguesia</b> \u2014 C\u00f3digo identificativo da freguesia.</li><li style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\"><b>Energia Ativa Simples (kWh)</b> \u2014 Consumo de energia ativa registado em tarif\u00e1rio simples (sem distin\u00e7\u00e3o de per\u00edodo hor\u00e1rio).</li><li style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\"><b>Energia Ativa Vazio (kWh)</b> \u2014 Consumo de energia ativa registado no per\u00edodo de vazio.</li><li style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\"><b>Energia Ativa Fora de Vazio (kWh) </b>\u2014 Consumo de energia ativa registado no per\u00edodo fora de vazio.</li><li style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\"><b>Energia Ativa Super Vazio (kWh)</b> \u2014 Consumo de energia ativa registado no per\u00edodo de super vazio.</li><li style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\"><b>Energia Ativa Ponta (kWh)</b> \u2014 Consumo de energia ativa registado no per\u00edodo de ponta.</li><li style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\"><b>Energia Ativa Cheias (kWh) </b>\u2014 Consumo de energia ativa registado no per\u00edodo de cheias.</li><li style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\"><b>Energia Ativa Total (kWh)</b> \u2014 Consumo total de energia ativa, correspondente \u00e0 soma de todos os per\u00edodos tarif\u00e1rios.</li></ul><p class=\"Paragraph SCXW84946739 BCX8\" paraeid=\"{92b89a3b-a102-4792-b805-cb8152004842}{8}\" paraid=\"679936465\" style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\"><br></p><p class=\"Paragraph SCXW84946739 BCX8\" paraeid=\"{92b89a3b-a102-4792-b805-cb8152004842}{8}\" paraid=\"679936465\" style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\"><br></p><p class=\"Paragraph SCXW84946739 BCX8\" paraeid=\"{92b89a3b-a102-4792-b805-cb8152004842}{8}\" paraid=\"679936465\" style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\">1. A Informa\u00e7\u00e3o disponibilizada pela E-REDES constitui uma aproxima\u00e7\u00e3o aos valores retirados de sistema e tem por refer\u00eancia o momento em que a mesma \u00e9 recolhida. Atendendo a que os pontos de liga\u00e7\u00e3o, a rede de distribui\u00e7\u00e3o de eletricidade, e os pr\u00f3prios valores de consumo e de produ\u00e7\u00e3o s\u00e3o naturalmente muito din\u00e2micos, salvaguarda-se que a informa\u00e7\u00e3o disponibilizada poder\u00e1 ser objeto de subsequentes altera\u00e7\u00f5es e atualiza\u00e7\u00f5es, ficando igualmente ressalvadas eventuais omiss\u00f5es e/ou pontuais imprecis\u00f5es de localiza\u00e7\u00e3o que a informa\u00e7\u00e3o poder\u00e1 conter.</p><p class=\"Paragraph SCXW84946739 BCX8\" paraeid=\"{92b89a3b-a102-4792-b805-cb8152004842}{8}\" paraid=\"679936465\" style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\"><br></p><p class=\"Paragraph SCXW84946739 BCX8\" paraeid=\"{92b89a3b-a102-4792-b805-cb8152004842}{8}\" paraid=\"679936465\" style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\"><br></p><p class=\"Paragraph SCXW84946739 BCX8\" paraeid=\"{92b89a3b-a102-4792-b805-cb8152004842}{8}\" paraid=\"679936465\" style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\"><br></p><p class=\"Paragraph SCXW84946739 BCX8\" paraeid=\"{92b89a3b-a102-4792-b805-cb8152004842}{8}\" paraid=\"679936465\" style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\">2. Desta forma a E-REDES n\u00e3o se responsabiliza perante terceiros, nomeadamente, parceiros, prestadores de servi\u00e7os, empreiteiros, utentes e clientes, pelos danos que possam surgir em consequ\u00eancia, direta ou indireta, do uso da presente Informa\u00e7\u00e3o, em particular aquando da realiza\u00e7\u00e3o de interven\u00e7\u00f5es, c\u00e1lculos e/ou estimativas, sem confirma\u00e7\u00e3o da exatid\u00e3o e atualiza\u00e7\u00e3o dos dados, pelo que devidamente se ressalva de que a consulta da presente informa\u00e7\u00e3o n\u00e3o prejudica o dever de se promover uma consulta direta \u00e0 E-REDES para obter informa\u00e7\u00e3o atualizada.</p><p class=\"Paragraph SCXW84946739 BCX8\" paraeid=\"{92b89a3b-a102-4792-b805-cb8152004842}{8}\" paraid=\"679936465\" style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\"><br></p><p class=\"Paragraph SCXW84946739 BCX8\" paraeid=\"{92b89a3b-a102-4792-b805-cb8152004842}{8}\" paraid=\"679936465\" style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\"><br></p><p class=\"Paragraph SCXW84946739 BCX8\" paraeid=\"{92b89a3b-a102-4792-b805-cb8152004842}{8}\" paraid=\"679936465\" style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\">Os dados fornecidos pelo Portal Open Data da E-REDES s\u00e3o abrangidos por licen\u00e7as abertas (CC BY 4.0). N\u00e3o existem restri\u00e7\u00f5es ao seu acesso, sob o compromisso de os utilizadores dos dados citarem o publicador. Assim, sugerimos que cite o Portal Open Data E-REDES como:</p><p class=\"Paragraph SCXW84946739 BCX8\" paraeid=\"{92b89a3b-a102-4792-b805-cb8152004842}{8}\" paraid=\"679936465\" style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\"><br></p><p class=\"Paragraph SCXW84946739 BCX8\" paraeid=\"{92b89a3b-a102-4792-b805-cb8152004842}{8}\" paraid=\"679936465\" style=\"-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px 0px 10.6667px; padding: 0px; user-select: text; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent;\">E-REDES \u2013 Distribui\u00e7\u00e3o de eletricidade, \u201cPortal Open Data E-REDES\u201d. Acedido em \u201cData\u201d. [Online] Dispon\u00edvel em https://e-rede