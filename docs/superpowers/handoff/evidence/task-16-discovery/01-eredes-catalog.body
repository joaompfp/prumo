pt": null}, {"name": "duration19", "description": null, "annotations": {}, "label": "D4", "type": "int", "label_en": "D4", "label_pt": "D4", "description_en": null, "description_pt": null}, {"name": "duration20", "description": null, "annotations": {}, "label": "D5", "type": "int", "label_en": "D5", "label_pt": "D5", "description_en": null, "description_pt": null}, {"name": "duration21", "description": null, "annotations": {}, "label": "X1", "type": "int", "label_en": "X1", "label_pt": "X1", "description_en": null, "description_pt": null}, {"name": "duration22", "description": null, "annotations": {}, "label": "X2", "type": "int", "label_en": "X2", "label_pt": "X2", "description_en": null, "description_pt": null}, {"name": "duration23", "description": null, "annotations": {}, "label": "X3", "type": "int", "label_en": "X3", "label_pt": "X3", "description_en": null, "description_pt": null}, {"name": "duration24", "description": null, "annotations": {}, "label": "X4", "type": "int", "label_en": "X4", "label_pt": "X4", "description_en": null, "description_pt": null}, {"name": "duration25", "description": null, "annotations": {}, "label": "X5", "type": "int", "label_en": "X5", "label_pt": "X5", "description_en": null, "description_pt": null}, {"name": "observations", "description": null, "annotations": {}, "label": "Observations", "type": "text", "label_en": "Observations", "label_pt": "Observa\u00e7\u00f5es", "description_en": null, "description_pt": null}, {"name": "exclusions", "description": null, "annotations": {}, "label": "Exclusions", "type": "text", "label_en": "Exclusions", "label_pt": "Exclus\u00f5es", "description_en": null, "description_pt": null}, {"name": "exception", "description": null, "annotations": {}, "label": "Exception", "type": "int", "label_en": "Exception", "label_pt": "Exce\u00e7\u00e3o", "description_en": null, "description_pt": null}, {"name": "aux1", "description": null, "annotations": {}, "label": "aux1", "type": "int", "label_en": "aux1", "label_pt": "aux1", "description_en": null, "description_pt": null}, {"name": "aux2", "description": null, "annotations": {}, "label": "aux2", "type": "int", "label_en": "aux2", "label_pt": "aux2", "description_en": null, "description_pt": null}, {"name": "aux3", "description": null, "annotations": {}, "label": "aux3", "type": "int", "label_en": "aux3", "label_pt": "aux3", "description_en": null, "description_pt": null}, {"name": "aux4", "description": null, "annotations": {}, "label": "aux4", "type": "int", "label_en": "aux4", "label_pt": "aux4", "description_en": null, "description_pt": null}, {"name": "aux5", "description": null, "annotations": {}, "label": "aux5", "type": "int", "label_en": "aux5", "label_pt": "aux5", "description_en": null, "description_pt": null}, {"name": "exceptional_event", "description": null, "annotations": {}, "label": "Exceptional Event", "type": "text", "label_en": "Exceptional Event", "label_pt": "Evento Excecional", "description_en": null, "description_pt": null}], "dataset_id": "qualidade_energia_cavas-final", "dataset_uid": "da_ws4c64", "has_records": true, "features": ["analyze", "timeserie", "custom_view"], "attachments": [], "alternative_exports": [], "data_visible": true, "metas": {"default": {"title": "Electrical Power Quality - Voltage Dips", "title_en": "Electrical Power Quality - Voltage Dips", "title_pt": "Qualidade de Energia El\u00e9trica - Cavas de Tens\u00e3o", "description": "<p style=\"\">This dataset presents the analysis of voltage dips on MV busbars in HV/MV substations, according to the classification table in NP EN 50160.</p><p style=\"\">For each monitoring point, the following information is presented:</p><p style=\"\">Number of voltage dips in each cell of the table, for the indicated period, excluding exceptional events and high-impact incidents in the process of classification as exceptional events.</p><p style=\"\">Number of voltage dips in each cell of the table, during the period of each exceptional event and high-impact incident in the process of classification as exceptional events.</p><p style=\"\">Polyphase aggregation (IEC 61000-4-30) and a 3-minute time interval are considered.</p><p style=\"\">The data are updated annually.</p><p style=\"\">These data result from the application of successive biannual monitoring plans for a set of selected points in the distribution network. Point selection takes into account a balanced geographic distribution, as well as the identification of customers as being more susceptible to voltage quality variations, according to the RQS</p><table style=\"width: 517px; background-color: rgb(255, 255, 255); margin-left: auto; margin-right: auto;\"><tbody><tr><td rowspan=\"2\" style=\"text-align: center;\"><span style=\"font-weight: bolder;\">Swell Voltage u (%)</span></td><td colspan=\"5\" style=\"text-align: center;\"><span style=\"font-weight: bolder;\">Duration t (ms)</span></td></tr><tr><td style=\"text-align: center;\"><span style=\"font-weight: bolder;\">10 \u2264 t \u2264 200</span></td><td style=\"text-align: center;\"><span style=\"font-weight: bolder;\">200 &lt; t \u2264 500</span></td><td style=\"text-align: center;\"><span style=\"font-weight: bolder;\">500 &lt; t \u2264 1000</span></td><td style=\"text-align: center;\"><span style=\"font-weight: bolder;\">1000 &lt; t \u2264 5000</span></td><td style=\"text-align: center;\"><span style=\"font-weight: bolder;\">500 &lt; t \u2264 60000</span></td></tr><tr><td style=\"text-align: center;\"><span style=\"font-weight: bolder;\">90 &gt; u \u2265 80</span></td><td style=\"text-align: center;\">Cell A1</td><td style=\"text-align: center;\">Cell A2</td><td style=\"text-align: center;\">Cell\u00a0A3</td><td style=\"text-align: center;\">Cell\u00a0A4</td><td style=\"text-align: center;\">Cell\u00a0A5</td></tr><tr><td style=\"text-align: center;\"><span style=\"font-weight: bolder;\">80 &gt; u \u2265 70</span></td><td style=\"text-align: center;\">Cell\u00a0B1</td><td style=\"text-align: center;\">Cell\u00a0B2</td><td style=\"text-align: center;\">Cell\u00a0B3</td><td style=\"text-align: center;\">Cell\u00a0B4</td><td style=\"text-align: center;\">Cell\u00a0B5</td></tr><tr><td style=\"text-align: center;\"><span style=\"font-weight: bolder;\">70 &gt; u \u2265 40</span></td><td style=\"text-align: center;\">Cell\u00a0C1</td><td style=\"text-align: center;\">Cell\u00a0C2</td><td style=\"text-align: center;\">Cell\u00a0C3</td><td style=\"text-align: center;\">Cell\u00a0C4</td><td style=\"text-align: center;\">Cell\u00a0C5</td></tr><tr><td style=\"text-align: center;\"><span style=\"font-weight: bolder;\">40 &gt; u \u2265 5</span></td><td style=\"text-align: center;\">Cell\u00a0D1</td><td style=\"text-align: center;\">Cell\u00a0D2</td><td style=\"text-align: center;\">Cell\u00a0\u00a0D3</td><td style=\"text-align: center;\">Cell\u00a0D4</td><td style=\"text-align: center;\">Cell\u00a0D5</td></tr><tr><td style=\"text-align: center;\"><span style=\"font-weight: bolder;\">5 &gt; u</span></td><td style=\"text-align: center;\">Cell\u00a0X1</td><td style=\"text-align: center;\">Cell\u00a0X2</td><td style=\"text-align: center;\">Cell\u00a0X3</td><td style=\"text-align: center;\">Cell\u00a0X4</td><td style=\"text-align: center;\"><p><span style=\"font-size: 0.875rem;\">Cell</span><span style=\"font-size: 0.875rem;\">\u00a0</span>X5</p></td></tr></tbody></table><p style=\"\"><br></p><p style=\"\">The data relating to the periods of exceptional events is not yet available in Open Data.</p><p style=\"\"><br></p><p style=\"\">1. The information provided by E-REDES is an approximation of the values \u200b\u200brelated to substations and the MV network as they are extracted from the systems and are based on the time the information was collected.</p><p style=\"\">2. Given that the connection points, the electricity distribution network, and the consumption and production values \u200b\u200bthemselves are naturally very dynamic, please note that the information provided may be subject to subsequent changes and updates, and reserves the right to accept any omissions and/or occasional location inaccuracies that the information may contain.</p><p style=\"\">3. The information provided by E-REDES is merely an approximation of the available network capacity at any given time. Therefore, it does not constitute a contractual proposal, nor does it replace consultation with E-REDES for the purpose of formulating regular grid connection requests (PLR).</p><p style=\"\">4. E-REDES ensures that the information provided does not imply connection to any specific network point or asset, or even to a specific solution within the scope of the PLR \u200b\u200bthat may be proposed. E-REDES reserves the right to evaluate the most appropriate technical solution on a case-by-case basis, based on the respective requests, in accordance with the principles to which it is legally bound.</p><p style=\"\">5. E-REDES is not liable to third parties, including partners, service providers, contractors, users, and customers, for any damages that may arise directly or indirectly from the use of this Information, particularly when performing interventions, calculations, and/or estimates without confirming the accuracy and updating of the data. Therefore, it is duly noted that consulting this information does not prejudice the obligation to consult E-REDES directly for updated information.</p><p style=\"\">6. The information provided is, for all legal purposes, the property of E-REDES and may not be copied, reproduced, adapted, modified, altered, deleted, destroyed, disseminated, transmitted, disclosed, or otherwise made available to third parties without expressly authorizing it to do so. Any reproduction, commercialization, or transfer to third parties, even free of charge, outside the specified terms or without the express authorization of E-REDES, is prohibited under applicable law and may result in civil and criminal liability.</p><p style=\"\"><br></p><p style=\"\">The data provided by the E-REDES Open Data Portal is covered by open licenses (CC BY 4.0). There are no restrictions on access, provided that data users acknowledge the publisher. Therefore, we suggest citing the E-REDES Open Data Portal as:</p><p style=\"\">E-REDES \u2013 Electricity Distribution, \"E-REDES Open Data Portal.\" Accessed under \"Data.\" [Online] Available at https://e-redes.opendatasoft.com/pages/homepage/</p><p style=\"\">If sharing on social media, please add #PortalOpenData_E_REDES</p>", "description_en": "<p style=\"\">This dataset presents the analysis of voltage dips on MV busbars in HV/MV substations, according to the classification table in NP EN 50160.</p><p style=\"\">For each monitoring point, the following information is presented:</p><p style=\"\">Number of voltage dips in each cell of the table, for the indicated period, excluding exceptional events and high-impact incidents in the process of classification as exceptional events.</p><p style=\"\">Number of voltage dips in each cell of the table, during the period of each exceptional event and high-impact incident in the process of classification as exceptional events.</p><p style=\"\">Polyphase aggregation (IEC 61000-4-30) and a 3-minute time interval are considered.</p><p style=\"\">The data are updated annually.</p><p style=\"\">These data result from the application of successive biannual monitoring plans for a set of selected points in the distribution network. Point selection takes into account a balanced geographic distribution, as well as the identification of customers as being more susceptible to voltage quality variations, according to the RQS</p><table style=\"width: 517px; background-color: rgb(255, 255, 255); margin-left: auto; margin-right: auto;\"><tbody><tr><td rowspan=\"2\" style=\"text-align: center;\"><span style=\"font-weight: bolder;\">Swell Voltage u (%)</span></td><td colspan=\"5\" style=\"text-align: center;\"><span style=\"font-weight: bolder;\">Duration t (ms)</span></td></tr><tr><td style=\"text-align: center;\"><span style=\"font-weight: bolder;\">10 \u2264 t \u2264 200</span></td><td style=\"text-align: center;\"><span style=\"font-weight: bolder;\">200 &lt; t \u2264 500</span></td><td style=\"text-align: center;\"><span style=\"font-weight: bolder;\">500 &lt; t \u2264 1000</span></td><td style=\"text-align: center;\"><span style=\"font-weight: bolder;\">1000 &lt; t \u2264 5000</span></td><td style=\"text-align: center;\"><span style=\"font-weight: bolder;\">500 &lt; t \u2264 60000</span></td></tr><tr><td style=\"text-align: center;\"><span style=\"font-weight: bolder;\">90 &gt; u \u2265 80</span></td><td style=\"text-align: center;\">Cell A1</td><td style=\"text-align: center;\">Cell A2</td><td style=\"text-align: center;\">Cell\u00a0A3</td><td style=\"text-align: center;\">Cell\u00a0A4</td><td style=\"text-align: center;\">Cell\u00a0A5</td></tr><tr><td style=\"text-align: center;\"><span style=\"font-weight: bolder;\">80 &gt; u \u2265 70</span></td><td style=\"text-align: center;\">Cell\u00a0B1</td><td style=\"text-align: center;\">Cell\u00a0B2</td><td style=\"text-align: center;\">Cell\u00a0B3</td><td style=\"text-align: center;\">Cell\u00a0B4</td><td style=\"text-align: center;\">Cell\u00a0B5</td></tr><tr><td style=\"text-align: center;\"><span style=\"font-weight: bolder;\">70 &gt; u \u2265 40</span></td><td style=\"text-align: center;\">Cell\u00a0C1</td><td style=\"text-align: center;\">Cell\u00a0C2</td><td style=\"text-align: center;\">Cell\u00a0C3</td><td style=\"text-align: center;\">Cell\u00a0C4</td><td style=\"text-align: center;\">Cell\u00a0C5</td></tr><tr><td style=\"text-align: center;\"><span style=\"font-weight: bolder;\">40 &gt; u \u2265 5</span></td><td style=\"text-align: center;\">Cell\u00a0D1</td><td style=\"text-align: center;\">Cell\u00a0D2</td><td style=\"text-align: center;\">Cell\u00a0\u00a0D3</td><td style=\"text-align: center;\">Cell\u00a0D4</td><td style=\"text-align: center;\">Cell\u00a0D5</td></tr><tr><td style=\"text-align: center;\"><span style=\"font-weight: bolder;\">5 &gt; u</span></td><td style=\"text-align: center;\">Cell\u00a0X1</td><td style=\"text-align: center;\">Cell\u00a0X2</td><td style=\"text-align: center;\">Cell\u00a0X3</td><td style=\"text-align: center;\">Cell\u00a0X4</td><td style=\"text-align: center;\"><p><span style=\"font-size: 0.875rem;\">Cell</span><span style=\"font-size: 0.875rem;\">\u00a0</span>X5</p></td></tr></tbody></table><p style=\"\"><br></p><p style=\"\">The data relating to the periods of exceptional events is not yet available in Open Data.</p><p style=\"\"><br></p><p style=\"\">1. The information provided by E-REDES is an approximation of the values \u200b\u200brelated to substations and the MV network as they are extracted from the systems and are based on the time the information was collected.</p><p style=\"\">2. Given that the connection points, the electricity distribution network, and the consumption and production values \u200b\u200bthemselves are naturally very dynamic, please note that the information provided may be subject to subsequent changes and updates, and reserves the right to accept any omissions and/or occasional location inaccuracies that the information may contain.</p><p style=\"\">3. The information provided by E-REDES is merely an approximation of the available network capacity at any given time. Therefore, it does not constitute a contractual proposal, nor does it replace consultation with E-REDES for the purpose of formulating regular grid connection requests (PLR).</p><p style=\"\">4. E-REDES ensures that the information provided does not imply connection to any specific network point or asset, or even to a specific solution within the scope of the PLR \u200b\u200bthat may be proposed. E-REDES reserves the right to evaluate the most appropriate technical solution on a case-by-case basis, based on the respective requests, in accordance with the principles to which it is legally bound.</p><p style=\"\">5. E-REDES is not liable to third parties, including partners, service providers, contractors, users, and customers, for any damages that may arise directly or indirectly from the use of this Information, particularly when performing interventions, calculations, and/or estimates without confirming the accuracy and updating of the data. Therefore, it is duly noted that consulting this information does not prejudice the obligation to consult E-REDES directly for updated information.</p><p style=\"\">6. The information provided is, for all legal purposes, the property of E-REDES and may not be copied, reproduced, adapted, modified, altered, deleted, destroyed, disseminated, transmitted, disclosed, or otherwise made available to third parties without expressly authorizing it to do so. Any reproduction, commercialization, or transfer to third parties, even free of charge, outside the specified terms or without the express authorization of E-REDES, is prohibited under applicable law and may result in civil and criminal liability.</p><p style=\"\"><br></p><p style=\"\">The data provided by the E-REDES Open Data Portal is covered by open licenses (CC BY 4.0). There are no restrictions on access, provided that data users acknowledge the publisher. Therefore, we suggest citing the E-REDES Open Data Portal as:</p><p style=\"\">E-REDES \u2013 Electricity Distribution, \"E-REDES Open Data Portal.\" Accessed under \"Data.\" [Online] Available at https://e-redes.opendatasoft.com/pages/homepage/</p><p style=\"\">If sharing on social media, please add #PortalOpenData_E_REDES</p>", "description_pt": "<p>Este Dataset apresenta a an\u00e1lise das cavas de tens\u00e3o dos barramentos MT de subesta\u00e7\u00f5es AT/MT, de acordo com a tabela de classifica\u00e7\u00e3o da norma NP EN 50160.</p><p>Para cada um dos pontos de monitoriza\u00e7\u00e3o \u00e9 apresentada a seguinte informa\u00e7\u00e3o:</p><ul><li>Quantidade de cavas de tens\u00e3o em cada c\u00e9lula da tabela, para o per\u00edodo indicado, excluindo eventos excecionais e incidentes de grande impacto em processo de classifica\u00e7\u00e3o como evento excecional</li><li>Quantidade de cavas de tens\u00e3o em cada c\u00e9lula da tabela, durante o per\u00edodo de cada evento excecional e incidente de grande impacto em processo de classifica\u00e7\u00e3o como evento excecional</li></ul><p>\u00c9 considerada agrega\u00e7\u00e3o polif\u00e1sica (IEC 61000-4-30) e temporal 3 minutos.</p><p>Os dados s\u00e3o atualizados anualmente.</p><p>Estes dados resultam da aplica\u00e7\u00e3o de sucessivos planos bianuais de monitoriza\u00e7\u00e3o de um conjunto de pontos selecionados da rede de distribui\u00e7\u00e3o. A sele\u00e7\u00e3o dos pontos tem em considera\u00e7\u00e3o uma distribui\u00e7\u00e3o geogr\u00e1fica equilibrada, bem como a identifica\u00e7\u00e3o de clientes como sendo mais suscet\u00edveis a varia\u00e7\u00f5es da qualidade de tens\u00e3o, de acordo com o RQS</p>\n\n<table style=\"margin-left: auto; margin-right: auto;\">\n                                    <tbody>\n                                        <tr>\n                                            <td rowspan=\"2\" style=\"text-align: center;\"><b>Tens\u00e3o Residual u (%)</b></td>\n                                            <td colspan=\"5\" style=\"text-align: center;\"><b>Dura\u00e7\u00e3o t (ms)</b></td>\n                                        </tr>\n                                        <tr>\n                                            <td style=\"text-align: center;\"><b>10 \u2264 t \u2264 200</b></td>\n                                            <td style=\"text-align: center;\"><b>200 &lt; t \u2264 500</b></td>\n                                            <td style=\"text-align: center;\"><b>500 &lt; t \u2264 1000</b></td>\n                                            <td style=\"text-align: center;\"><b>1000 &lt; t \u2264 5000</b></td>\n                                            <td style=\"text-align: center;\"><b>500 &lt; t \u2264 60000</b></td>\n                                        </tr>\n                                        <tr>\n                                            <td style=\"text-align: center;\"><b>90 &gt; u \u2265 80</b></td>\n                                            <td style=\"text-align: center;\">C\u00e9lula A1</td>\n                                            <td style=\"text-align: center;\">C\u00e9lula A2</td>\n                                            <td style=\"text-align: center;\">C\u00e9lula A3</td><td style=\"text-align: center;\">C\u00e9lula A4</td><td style=\"text-align: center;\">C\u00e9lula A5</td>\n                                        </tr>\n                                        <tr>\n                                            <td style=\"text-align: center;\"><b>80 &gt; u \u2265 70</b></td>\n                                            <td style=\"text-align: center;\">C\u00e9lula B1</td><td style=\"text-align: center;\">C\u00e9lula B2</td><td style=\"text-align: center;\">C\u00e9lula B3</td><td style=\"text-align: center;\">C\u00e9lula B4</td><td style=\"text-align: center;\">C\u00e9lula B5</td>\n                                        </tr>\n                                        <tr>\n                                            <td style=\"text-align: center;\"><b>70 &gt; u \u2265 40</b></td><td style=\"text-align: center;\">C\u00e9lula C1</td><td style=\"text-align: center;\">C\u00e9lula C2</td><td style=\"text-align: center;\">C\u00e9lula C3</td><td style=\"text-align: center;\">C\u00e9lula C4</td>\n                                            <td style=\"text-align: center;\">C\u00e9lula C5</td>\n                                        </tr>\n                                        <tr>\n                                            <td style=\"text-align: center;\"><b>40 &gt; u \u2265 5</b></td><td style=\"text-align: center;\">C\u00e9lula D1</td><td style=\"text-align: center;\">C\u00e9lula D2</td><td style=\"text-align: center;\">C\u00e9lula D3</td><td style=\"text-align: center;\">C\u00e9lula D4</td><td style=\"text-align: center;\">C\u00e9lula D5</td>\n                                        </tr>\n                                        <tr>\n                                            <td style=\"text-align: center;\"><b>5 &gt; u</b></td>\n                                            <td style=\"text-align: center;\">C\u00e9lula X1</td><td style=\"text-align: center;\">C\u00e9lula X2</td><td style=\"text-align: center;\">C\u00e9lula X3</td><td style=\"text-align: center;\">C\u00e9lula X4</td><td style=\"text-align: center;\"><p>C\u00e9lula X5</p></td></tr></tbody></table><div><br></div><div>No Open Data n\u00e3o est\u00e1 ainda dispon\u00edvel os dados relativos aos per\u00edodos dos eventos excepcionais.</div><div><br></div><div>1. A Informa\u00e7\u00e3o disponibilizada pela E-REDES constitui uma aproxima\u00e7\u00e3o aos valores relativos \u00e0s subesta\u00e7\u00f5es e rede MT conforme s\u00e3o retirados dos sistemas e t\u00eam por refer\u00eancia o momento em que a informa\u00e7\u00e3o \u00e9 recolhida.\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0\u00a0</div><div><br></div><div>2. Atendendo a que os pontos de liga\u00e7\u00e3o, a rede de distribui\u00e7\u00e3o de eletricidade, e os pr\u00f3prios valores de consumo e de produ\u00e7\u00e3o s\u00e3o naturalmente muito din\u00e2micos, salvaguarda-se que a informa\u00e7\u00e3o disponibilizada poder\u00e1 ser objeto de subsequentes altera\u00e7\u00f5es e atualiza\u00e7\u00f5es, ficando igualmente ressalvadas eventuais omiss\u00f5es e/ou pontuais imprecis\u00f5es de localiza\u00e7\u00e3o que a informa\u00e7\u00e3o poder\u00e1 conter.</div><div><br></div><div>3. A informa\u00e7\u00e3o disponibilizada pela E-REDES consiste apenas numa aproxima\u00e7\u00e3o quanto \u00e0 capacidade dispon\u00edvel das redes, a cada momento, pelo que n\u00e3o consubstancia uma proposta contratual, nem dispensa a consulta da E-REDES para efeitos da formula\u00e7\u00e3o dos habituais pedidos de liga\u00e7\u00e3o \u00e0 rede (PLR).</div><div><br></div><div>4. A E-REDES salvaguarda que a informa\u00e7\u00e3o disponibilizada n\u00e3o vincula \u00e0 liga\u00e7\u00e3o a qualquer ponto ou ativo espec\u00edfico da rede, ou sequer a uma solu\u00e7\u00e3o espec\u00edfica no \u00e2mbito dos PLR que venham a ser colocados, reservando-se a E-REDES a avaliar caso a caso, em face dos respetivos pedidos, a solu\u00e7\u00e3o t\u00e9cnica que seja a mais adequada, de acordo com os princ\u00edpios a que est\u00e1 legalmente obrigada.</div><div><br></div><div>5. A E-REDES n\u00e3o se responsabiliza perante terceiros, nomeadamente, parceiros, prestadores de servi\u00e7os, empreiteiros, utentes e clientes, pelos danos que possam surgir em consequ\u00eancia, direta ou indireta, do uso da presente Informa\u00e7\u00e3o, em particular aquando da realiza\u00e7\u00e3o de interven\u00e7\u00f5es, c\u00e1lculos e/ou estimativas, sem confirma\u00e7\u00e3o da exatid\u00e3o e atualiza\u00e7\u00e3o dos dados, pelo que devidamente se ressalva de que a consulta da presente informa\u00e7\u00e3o n\u00e3o prejudica o dever de se promover uma consulta direta \u00e0 E-REDES para obter informa\u00e7\u00e3o atualizada.</div><div><br></div><div>6. A informa\u00e7\u00e3o disponibilizada \u00e9, para os devidos efeitos legais, propriedade da E-REDES, n\u00e3o devendo ser copiada, reproduzida, adaptada, modificada, alterada, apagada, destru\u00edda, difundida, transmitida, divulgada ou por qualquer outra forma ser colocada \u00e0 disposi\u00e7\u00e3o de terceiros, sem que para tal tenha sido expressamente validada pela E-REDES. A sua reprodu\u00e7\u00e3o, comercializa\u00e7\u00e3o ou ced\u00eancia a terceiros, mesmo que a t\u00edtulo gratuito, fora dos pressupostos indicados ou sem autoriza\u00e7\u00e3o expressa da E-REDES \u00e9 interdita nos termos legais aplic\u00e1veis e poder\u00e1 implicar responsabilidade civil e criminal.\u00a0</div><div><br></div><div><br></div><div><br></div><div>Os dados fornecidos pelo Portal Open Data da E-REDES s\u00e3o abrangidos por licen\u00e7as abertas (CC BY 4.0). N\u00e3o existem restri\u00e7\u00f5es ao seu acesso, sob o compromisso de os utilizadores dos dados citarem o publicador. Assim, sugerimos que cite o Portal Open Data E-REDES como:</div><div><br></div><div>E-REDES \u2013 Distribui\u00e7\u00e3o de eletricidade, \u201cPortal Open Data E-REDES\u201d. Acedido em \u201cData\u201d. [Online] Dispon\u00edvel em https://e-redes.opendatasoft.com/pages/homepage/</div><div><br></div><div>Se partilhar nas redes sociais, por favor acrescente #PortalOpenData_E_REDES</div>", "theme": ["Operation and Quality of Service"], "theme_en": ["Operation and Quality of Service"], "theme_pt": ["Opera\u00e7\u00e3o e Qualidade de Servi\u00e7o"], "keyword": null, "keyword_en": null, "keyword_pt": null, "license": "CC BY 4.0", "license_en": "CC BY 4.0", "license_pt": "CC BY 4.0", "license_url": "https://creativecommons.org/licenses/by/4.0/", "license_url_en": "https://creativecommons.org/licenses/by/4.0/", "license_url_pt": "https://creativecommons.org/licenses/by/4.0/", "language": "pt", "modified": "2025-06-22T17:28:27+00:00", "publisher": "E-REDES", "publisher_en": "E-REDES", "publisher_pt": "E-REDES", "references": null, "attributions": null, "update_frequency": null, "bbox": null, "data_processed": "2025-12-09T12:30:36+00:00", "federated": false, "geographic_reference": null, "geographic_reference_auto": false, "geometry_types": null, "metadata_languages": ["pt", "en"], "metadata_processed": "2026-09-03T09:56:17.993000+00:00", "modified_updates_on_data_change": false, "modified_updates_on_metadata_change": false, "parent_domain": null, "records_count": 2846, "shared_catalog": null, "source_dataset": null, "source_domain": null, "source_domain_address": null, "source_domain_title": null, "territory": null, "timezone": null}, "custom": {"perfis-de-utilizacao": null, "atualizado": null}}}, {"visibility": "domain", "fields": [{"name": "data", "description": null, "annotations": {"timeserie_precision": "month"}, "label": "Date", "type": "date", "label_en": "Date", "label_pt": "Data", "description_en": null, "description_pt": null}, {"name": "ano", "description": null, "annotations": {}, "label": "Year", "type": "text", "label_en": "Year", "label_pt": "Ano", "description_en": null, "description_pt": null}, {"name": "mes", "description": null, "annotations": {}, "label": "Month", "type": "text", "label_en": "Month", "label_pt": "M\u00eas", "description_en": null, "description_pt": null}, {"name": "dis_name", "description": null, "annotations": {}, "label": "District", "type": "text", "label_en": "District", "label_pt": "Distrito", "description_en": null, "description_pt": null}, {"name": "con_name", "description": null, "annotations": {}, "label": "Municipality", "type": "text", "label_en": "Municipality", "label_pt": "Concelho", "description_en": null, "description_pt": null}, {"name": "fre_name", "description": null, "annotations": {}, "label": "Parish", "type": "text", "label_en": "Parish", "label_pt": "Freguesia", "description_en": null, "description_pt": null}, {"name": "segmento_de_potencia_contratada", "description": null, "annotations": {}, "label": "Contracted Power Segment (kVA)", "type": "text", "label_en": "Contracted Power Segment (kVA)", "label_pt": "Segmento de Pot\u00eancia Contratada (kVA)", "description_en": null, "description_pt": null}, {"name": "numero_de_contratos", "description": null, "annotations": {}, "label": "Number of Contracts", "type": "double", "label_en": "Number of Contracts", "label_pt": "N\u00famero de Contratos", "description_en": null, "description_pt": null}, {"name": "dis_code", "description": null, "annotations": {}, "label": "District Code", "type": "text", "label_en": "District Code", "label_pt": "C\u00f3digo Distrito", "description_en": null, "description_pt": null}, {"name": "con_code", "description": null, "annotations": {}, "label": "Municipality Code", "type": "text", "label_en": "Municipality Code", "label_pt": "C\u00f3digo Concelho", "description_en": null, "description_pt": null}, {"name": "fre_code", "description": null, "annotations": {}, "label": "Parish Code", "type": "text", "label_en": "Parish Code", "label_pt": "C\u00f3digo Freguesia", "description_en": null, "description_pt": null}], "dataset_id": "clientes-por-escalao-de-potencia", "dataset_uid": "da_ynj4mi", "has_records": true, "features": ["timeserie", "analyze", "custom_view"], "attachments": [], "alternative_exports": [], "data_visible": true, "metas": {"default": {"title": "Customers by Power Capacity Bands", "title_en": "Customers by Power Capacity Bands", "title_pt": "Clientes por Escal\u00f5es de Pot\u00eancia", "description": "<p>This dataset presents the number of customers grouped by contracted/maximum power consumption segment in the distribution network operated by E-REDES, organized by state, municipality, and parish.</p><p>The data allows for the characterization of customer distribution by contracted/maximum power consumption range in each territory, enabling the identification of potential consumption patterns and electricity grid usage profiles at the local level.</p><p>It allows for monitoring the monthly evolution of the number of customers per power segment, supporting studies on the socioeconomic profile of territories, especially the identification of areas with a higher prevalence of low-power contracts, frequently associated with situations of energy poverty.</p><p><br></p><p><b>Use cases:</b></p><ul><li>Energy poverty.</li><li>Analysis of customer distribution by contracted/maximum power consumption range, by state, municipality, and parish.</li><li>Identification of territories with a higher concentration of low-power contracts.</li><li>Monitoring the monthly evolution of the number of customers per power segment.</li><li>Support for socioeconomic studies and public policies related to access to energy.</li></ul><p><br></p><p><b>Update frequency: </b>monthly</p><p><br></p><p><b>Variables included:</b></p><ul><li><b>Year/Month</b> \u2014 Information reference period, in year and month format.</li><li><b style=\"font-family: inherit;\">District</b><span style=\"font-family: inherit;\"> \u2014 Name of the district where customers are located.</span></li><li><b style=\"font-family: inherit;\">District Code</b><span style=\"font-family: inherit;\"> \u2014 District identifier code.</span></li><li><b style=\"font-family: inherit;\">Municipality </b><span style=\"font-family: inherit;\">\u2014 Name of the municipality where customers are located.</span></li><li><b style=\"font-family: inherit;\">Municipality Code</b><span style=\"font-family: inherit;\"> \u2014 Municipality identifier code.</span></li><li><b style=\"font-family: inherit;\">Parish</b><span style=\"font-family: inherit;\"> \u2014 Name of the parish where customers are located.</span></li><li><b style=\"font-family: inherit;\">Parish Code</b><span style=\"font-family: inherit;\"> \u2014 Parish identifier code.</span></li><li><b>Contracted/maximum power segment</b> \u2014 Range in which the customers' power falls. For customers with contracted power in normal low voltage (BTN) we have ranges from 1.15 kVA to 41.4 kVA. For customers not in normal low voltage (MAT/AT/MT/BTE) where the contracted power is the maximum value of the power taken in the last 12 months in a 15-minute period we have the steps of [0;10[ \u2026 &gt;50000 kVA. For Public Lighting (PL) where the contracted power is the maximum monthly power consumption over a 15-minute period, we have the ranges of [0;10[ \u2026 &gt;50000 kVA.</li><li><b>Number of Contracts</b> \u2014 Quantity of active customers/contracts associated with the power segment and the territory under analysis.</li></ul><p><br></p><p>1. The information provided by E-REDES is an approximation of the values \u200b\u200bretrieved from the system and refers to the moment it is collected. Given that the connection points, the electricity distribution network, and the consumption and production values \u200b\u200bthemselves are naturally very dynamic, it is understood that the information provided may be subject to subsequent changes and updates, and any omissions and/or occasional location inaccuracies that the information may contain are also reserved.</p><p><br></p><p>2. Therefore, E-REDES is not liable to third parties, namely partners, service providers, contractors, users and clients, for any damages that may arise as a direct or indirect consequence of the use of this Information, particularly when carrying out interventions, calculations and/or estimates, without confirmation of the accuracy and updating of the data. It is duly noted that consulting this information does not prejudice the obligation to directly contact E-REDES to obtain updated information.</p><p><br></p><p>The data provided by the E-REDES Open Data Portal is covered by open licenses (CC BY 4.0). There are no restrictions on access, provided that users of the data cite the publisher. Therefore, we suggest that you cite the E-REDES Open Data Portal as:</p><p><br></p><p>E-REDES \u2013 Electricity Distribution, \u201cE-REDES Open Data Portal\u201d. Accessed on \u201cDate\u201d. [Online] Available at https://e-redes.opendatasoft.com/pages/homepage/</p><p><br></p><p>If you share on social media, please add #PortalOpenData_E_REDES</p>", "description_en": "<p>This dataset presents the number of customers grouped by contracted/maximum power consumption segment in the distribution network operated by E-REDES, organized by state, municipality, and parish.</p><p>The data allows for the characterization of customer distribution by contracted/maximum power consumption range in each territory, enabling the identification of potential consumption patterns and electricity grid usage profiles at the local level.</p><p>It allows for monitoring the monthly evolution of the number of customers per power segment, supporting studies on the socioeconomic profile of territories, especially the identification of areas with a higher prevalence of low-power contracts, frequently associated with situations of energy poverty.</p><p><br></p><p><b>Use cases:</b></p><ul><li>Energy poverty.</li><li>Analysis of customer distribution by contracted/maximum power consumption range, by state, municipality, and parish.</li><li>Identification of territories with a higher concentration of low-power contracts.</li><li>Monitoring the monthly evolution of the number of customers per power segment.</li><li>Support for socioeconomic studies and public policies related to access to energy.</li></ul><p><br></p><p><b>Update frequency: </b>monthly</p><p><br></p><p><b>Variables included:</b></p><ul><li><b>Year/Month</b> \u2014 Information reference period, in year and month format.</li><li><b style=\"font-family: inherit;\">District</b><span style=\"font-family: inherit;\"> \u2014 Name of the district where customers are located.</span></li><li><b style=\"font-family: inherit;\">District Code</b><span style=\"font-family: inherit;\"> \u2014 District identifier code.</span></li><li><b style=\"font-family: inherit;\">Municipality </b><span style=\"font-family: inherit;\">\u2014 Name of the municipality where customers are located.</span></li><li><b style=\"font-family: inherit;\">Municipality Code</b><span style=\"font-family: inherit;\"> \u2014 Municipality identifier code.</span></li><li><b style=\"font-family: inherit;\">Parish</b><span style=\"font-family: inherit;\"> \u2014 Name of the parish where customers are located.</span></li><li><b style=\"font-family: inherit;\">Parish Code</b><span style=\"font-family: inherit;\"> \u2014 Parish identifier code.</span></li><li><b>Contracted/maximum power segment</b> \u2014 Range in which the customers' power falls. For customers with contracted power in normal low voltage (BTN) we have ranges from 1.15 kVA to 41.4 kVA. For customers not in normal low voltage (MAT/AT/MT/BTE) where the contracted power is the maximum value of the power taken in the last 12 months in a 15-minute period we have the steps of [0;10[ \u2026 &gt;50000 kVA. For Public Lighting (PL) where the contracted power is the maximum monthly power consumption over a 15-minute period, we have the ranges of [0;10[ \u2026 &gt;50000 kVA.</li><li><b>Number of Contracts</b> \u2014 Quantity of active customers/contracts associated with the power segment and the territory under analysis.</li></ul><p><br></p><p>1. The information provided by E-REDES is an approximation of the values \u200b\u200bretrieved from the system and refers to the moment it is collected. Given that the connection points, the electricity distribution network, and the consumption and production values \u200b\u200bthemselves are naturally very dynamic, it is understood that the information provided may be subject to subsequent changes and updates, and any omissions and/or occasional location inaccuracies that the information may contain are also reserved.</p><p><br></p><p>2. Therefore, E-REDES is not liable to third parties, namely partners, service providers, contractors, users and clients, for any damages that may arise as a direct or indirect consequence of the use of this Information, particularly when carrying out interventions, calculations and/or estimates, without confirmation of the accuracy and updating of the data. It is duly noted that consulting this information does not prejudice the obligation to directly contact E-REDES to obtain updated information.</p><p><br></p><p>The data provided by the E-REDES Open Data Portal is covered by open licenses (CC BY 4.0). There are no restrictions on access, provided that users of the data cite the publisher. Therefore, we suggest that you cite the E-REDES Open Data Portal as:</p><p><br></p><p>E-REDES \u2013 Electricity Distribution, \u201cE-REDES Open Data Portal\u201d. Accessed on \u201cDate\u201d. [Online] Available at https://e-redes.opendatasoft.com/pages/homepage/</p><p><br></p><p>If you share on social media, please add #PortalOpenData_E_REDES</p>", "description_pt": "<p>Este dataset apresenta o n\u00famero de clientes agrupados por segmento de pot\u00eancia contratada/m\u00e1xima tomada, na rede de distribui\u00e7\u00e3o operada pela E-REDES, organizados por distrito, concelho e freguesia.</p><p>Os dados permitem caracterizar a distribui\u00e7\u00e3o dos clientes por escal\u00e3o de pot\u00eancia contratada/m\u00e1xima tomada em cada territ\u00f3rio, possibilitando identificar padr\u00f5es de consumo potencial e perfis de utiliza\u00e7\u00e3o da rede el\u00e9trica a n\u00edvel local.</p><p>Permite acompanhar a evolu\u00e7\u00e3o mensal do n\u00famero de clientes por segmento de pot\u00eancia, apoiando estudos sobre o perfil socioecon\u00f3mico dos territ\u00f3rios, nomeadamente a identifica\u00e7\u00e3o de zonas com maior preval\u00eancia de contratos de baixa pot\u00eancia, frequentemente associados a situa\u00e7\u00f5es de pobreza energ\u00e9tica.</p><p>\u00a0</p><p><b>Casos de uso:</b></p><ul><li>Pobreza energ\u00e9tica.</li><li>An\u00e1lise da distribui\u00e7\u00e3o de clientes por escal\u00e3o de pot\u00eancia contratada/m\u00e1xima tomada, por distrito, concelho e freguesia.</li><li>Identifica\u00e7\u00e3o de territ\u00f3rios com maior concentra\u00e7\u00e3o de contratos de baixa pot\u00eancia.</li><li>Acompanhamento da evolu\u00e7\u00e3o mensal do n\u00famero de clientes por segmento de pot\u00eancia.</li><li>Apoio a estudos socioecon\u00f3micos e de pol\u00edticas p\u00fablicas relacionadas com o acesso \u00e0 energia.</li></ul><p>\u00a0</p><p><b>Periodicidade de atualiza\u00e7\u00e3o:</b> mensal</p><p>\u00a0</p><p><b>Vari\u00e1veis inclu\u00eddas:</b></p><ul><li><b>Ano/M\u00eas</b> \u2014 Per\u00edodo de refer\u00eancia da informa\u00e7\u00e3o, no formato ano e m\u00eas.</li><li><b>Distrito</b> \u2014 Nome do distrito onde se localizam os clientes.</li><li><b>C\u00f3digo Distrito</b> \u2014 C\u00f3digo identificativo do distrito.</li><li><b>Concelho</b> \u2014 Nome do concelho onde se localizam os clientes.</li><li><b>C\u00f3digo Concelho</b> \u2014 C\u00f3digo identificativo do concelho.</li><li><b>Freguesia</b> \u2014 Nome da freguesia onde se localizam os clientes.</li><li><b>C\u00f3digo Freguesia</b> \u2014 C\u00f3digo identificativo da freguesia.</li><li><b>Segmento de Pot\u00eancia Contratada/m\u00e1xima tomada</b> \u2014 Escal\u00e3o em que se enquadra a pot\u00eancia dos clientes. Para Clientes de pot\u00eancia contratada em baixa tens\u00e3o normal (BTN) temos os escal\u00f5es de 1,15 kVA at\u00e9 41,4kVA. Para clientes n\u00e3o baixa tens\u00e3o normal (MAT/AT/MT/BTE) onde a pot\u00eancia contratada \u00e9 o valor m\u00e1ximo da pot\u00eancia tomada dos \u00faltimos 12 meses num per\u00edodo de 15 minutos temos os escal\u00f5es de [0;10[ \u2026 &gt;50000 kVA. Para Ilumina\u00e7\u00e3o p\u00fablica (IP) onde a pot\u00eancia contratada \u00e9 o valor m\u00e1ximo da pot\u00eancia tomada mensal num per\u00edodo de 15 minutos temos os escal\u00f5es de [0;10[ \u2026 &gt;50000 kVA.</li><li><b>N\u00famero de Contratos</b> \u2014 Quantidade de clientes/contratos ativos associados ao segmento de pot\u00eancia e ao territ\u00f3rio em an\u00e1lise.</li></ul><p><br></p><p>1. A Informa\u00e7\u00e3o disponibilizada pela E-REDES constitui uma aproxima\u00e7\u00e3o aos valores retirados de sistema e tem por refer\u00eancia o momento em que a mesma \u00e9 recolhida. Atendendo a que os pontos de liga\u00e7\u00e3o, a rede de distribui\u00e7\u00e3o de eletricidade, e os pr\u00f3prios valores de consumo e de produ\u00e7\u00e3o s\u00e3o naturalmente muito din\u00e2micos, salvaguarda-se que a informa\u00e7\u00e3o disponibilizada poder\u00e1 ser objeto de subsequentes altera\u00e7\u00f5es e atualiza\u00e7\u00f5es, ficando igualmente ressalvadas eventuais omiss\u00f5es e/ou pontuais imprecis\u00f5es de localiza\u00e7\u00e3o que a informa\u00e7\u00e3o poder\u00e1 conter.</p><p><br></p><p>2. Desta forma a E-REDES n\u00e3o se responsabiliza perante terceiros, nomeadamente, parceiros, prestadores de servi\u00e7os, empreiteiros, utentes e clientes, pelos danos que possam surgir em consequ\u00eancia, direta ou indireta, do uso da presente Informa\u00e7\u00e3o, em particular aquando da realiza\u00e7\u00e3o de interven\u00e7\u00f5es, c\u00e1lculos e/ou estimativas, sem confirma\u00e7\u00e3o da exatid\u00e3o e atualiza\u00e7\u00e3o dos dados, pelo que devidamente se ressalva de que a consulta da presente informa\u00e7\u00e3o n\u00e3o prejudica o dever de se promover uma consulta direta \u00e0 E-REDES para obter informa\u00e7\u00e3o atualizada.</p><p>\u00a0</p><p>Os dados fornecidos pelo Portal Open Data da E-REDES s\u00e3o abrangidos por licen\u00e7as abertas (CC BY 4.0). N\u00e3o existem restri\u00e7\u00f5es ao seu acesso, sob o compromisso de os utilizadores dos dados citarem o publicador. Assim, sugerimos que cite o Portal Open Data E-REDES como:</p><p>\u00a0</p><p>E-REDES \u2013 Distribui\u00e7\u00e3o de eletricidade, \u201cPortal Open Data E-REDES\u201d. Acedido em \u201cData\u201d. [Online] Dispon\u00edvel em https://e-redes.opendatasoft.com/pages/homepage/</p><p>\u00a0</p><p>Se partilhar nas redes sociais, por favor acrescente #PortalOpenData_E_REDES</p>", "theme": ["Consumption and Energy"], "theme_en": ["Consumption and Energy"], "theme_pt": ["Consumos e Energia"], "keyword": null, "keyword_en": null, "keyword_pt": null, "license": "CC BY 4.0", "license_en": "CC BY 4.0", "license_pt": "CC BY 4.0", "license_url": "https://creativecommons.org/licenses/by/4.0/", "license_url_en": "https://creativecommons.org/licenses/by/4.0/", "license_url_pt": "https://creativecommons.org/licenses/by/4.0/", "language": "pt", "modified": "2026-10-19T09:40:11+00:00", "publisher": "E-REDES", "publisher_en": "E-REDES", "publisher_pt": "E-REDES", "references": null, "attributions": null, "update_frequency": "MONTHLY", "bbox": null, "data_processed": "2026-10-19T09:40:11+00:00", "federated": false, "geographic_reference": null, "geographic_reference_auto": false, "geometry_types": null, "metadata_languages": ["pt", "en"], "metadata_processed": "2026-10-19T09:40:11.273000+00:00", "modified_updates_on_data_change": true, "modified_updates_on_metadata_change": false, "parent_domain": null, "records_count": 2293254, "shared_catalog": null, "source_dataset": null, "source_domain": null, "source_domain_address": null, "source_domain_title": null, "territory": null, "timezone": "Europe/Lisbon"}, "custom": {"perfis-de-utilizacao": null, "atualizado": null}}}, {"visibility": "domain", "fields": [{"name": "ano", "description": null, "annotations": {}, "label": "Year", "type": "text", "label_en": "Year", "label_pt": "Ano", "description_en": null, "description_pt": null}, {"name": "mes", "description": null, "annotations": {"facetsort": "-count"}, "label": "Month", "type": "text", "label_en": "Month", "label_pt": "M\u00eas", "description_en": null, "description_pt": null}, {"name": "data", "description": null, "annotations": {"facetsort": "-count", "timeserie_precision": "month", "facet": true}, "label": "Date", "type": "date", "label_en": "Date", "label_pt": "Data", "description_en": null, "description_pt": null}, {"name": "distrito", "description": null, "annotations": {"facet": true}, "label": "District", "type": "text", "label_en": "District", "label_pt": "Distrito", "description_en": null, "description_pt": null}, {"name": "concelho", "description": null, "annotations": {"facet": true}, "label": "Municipality", "type": "text", "label_en": "Municipality", "label_pt": "Concelho", "description_en": null, "description_pt": null}, {"name": "freguesia", "description": null, "annotations": {"facet": true}, "label": "Parish", "type": "text", "label_en": "Parish", "label_pt": "Freguesia", "description_en": null, "description_pt": null}, {"name": "mobilidade_eletrica", "description": null, "annotations": {}, "label": "Electric mobility", "type": "text", "label_en": "Electric mobility", "label_pt": "Mobilidade el\u00e9trica", "description_en": null, "description_pt": null}, {"name": "cpes_com_dcs_recolhidos", "description": null, "annotations": {}, "label": "CPES with DCS collected", "type": "int", "label_en": "CPES with DCS collected", "label_pt": "CPES com DCS recolhidos", "description_en": null, "description_pt": null}, {"name": "coddistrito", "description": null, "annotations": {}, "label": "District Code", "type": "text", "label_en": "District Code", "label_pt": "C\u00f3digo Distrito", "description_en": null, "description_pt": null}, {"name": "coddistritoconcelho", "description": null, "annotations": {}, "label": "Municipality Code", "type": "text", "label_en": "Municipality Code", "label_pt": "C\u00f3digo Concelho", "description_en": null, "description_pt": null}, {"name": "coddistritoconcelhofreguesia", "description": null, "annotations": {}, "label": "Parish Code", "type": "text", "label_en": "Parish Code", "label_pt": "C\u00f3digo Freguesia", "description_en": null, "description_pt": null}], "dataset_id": "22-diagrama-de-carga-por-instalacao", "dataset_uid": "da_0fd4hv", "has_records": true, "features": ["analyze", "timeserie"], "attachments": [], "alternative_exports": [], "data_visible": true, "metas": {"default": {"title": "Number of low voltage delivery points with collection of Load Diagrams", "title_en": "Number of low voltage delivery points with collection of Load Diagrams", "title_pt": "N\u00famero de locais de consumo de baixa tens\u00e3o com recolha de Diagramas de Carga", "description": "<p>Number of low voltage consumption sites with collection of load diagrams, by district, municipality and parish (incl. PCVEs). History &gt;2022</p><p>For the\nmunicipality of \u00c9vora, the data collection of remote readings and load diagrams does not include CPEs with 1st generation meters, as this equipment is being\nprogressively replaced until the end of 2024.</p><p><br></p><p></p><p>1. The information made available by E-REDES constitutes an approximation to the values taken from the system and is based on the moment in which it is collected. Given that the connection points, the electricity distribution network, and the consumption and production values themselves are naturally very dynamic, it is safeguarded that the information made available may be subject to subsequent changes and updates, with the exception of any omissions and/or occasional inaccuracies of location that the information may contain.<br></p><p>2. In this way, E-REDES is not liable to third parties, namely, partners, service providers, contractors, users and customers, for damages that may arise as a result, direct or indirect, of the use of this Information, in particular when carrying out interventions, calculations and/or estimates, without confirming the accuracy and updating of the data, whereby it is duly noted that the consultation of this information does not affect the duty to promote a direct consultation with E-REDES in order to obtain updated information.</p><p><br></p><p><span style=\"font-size: inherit;\">The data provided by the E-REDES Open Data Portal is covered by open licenses (CC BY 4.0). There are no restrictions on access, under the commitment that data users cite the publisher.\u00a0Therefore, we suggest that you cite the Open Data E-REDES Portal as:</span></p><p><span style=\"font-size: inherit;\">E-REDES \u2013 Distribui\u00e7\u00e3o de Eletricidade, \u201cE-REDES Open Data Portal\u201d. Accessed in \u201cData\u201d. [Online] Available at </span><a aria-label=\"Link https://e-redes.opendatasoft.com/pages/homepage/\" class=\"fui-Link ___1rxvrpe f2hkw1w f3rmtva f1ewtqcl fyind8e f1k6fduh f1w7gpdv fk6fouc fjoy568 figsok6 f1hu3pq6 f11qmguv f19f4twv f1tyq0we f1g0x7ka fhxju0i f1qch9an f1cnd47f fqv5qza f1vmzxwi f1o700av f13mvf36 f1cmlufx f9n3di6 f1ids18y f1tx3yz7 f1deo86v f1eh06m1 f1iescvh fhgqx19 f1olyrje f1p93eir f1nev41a f1h8hb77 f1lqvz6u f10aw75t fsle3fq f17ae5zn\" href=\"https://e-redes.opendatasoft.com/pages/homepage/\" rel=\"noreferrer noopener\" target=\"_blank\" title=\"https://e-redes.opendatasoft.com/pages/homepage/\"><span style=\"font-size: inherit;\">https://e-redes.opendatasoft.com/pages/homepage/</span></a></p><p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;\"><span lang=\"EN-US\" style=\"font-size: 10.5pt; font-family: Arial, sans-serif;\"><o:p><span class=\"ui-provider a b c d e f g h i j k l m n o p q r s t u v w x y z ab ac ae af ag ah ai aj ak\" dir=\"ltr\"></span></o:p></span></p><p class=\"\"><span style=\"font-size: inherit;\">If you share on social media, please add #PortalOpenData_E_REDES</span></p><p><span style=\"font-size: inherit;\"><br></span></p>", "description_en": "<p>Number of low voltage consumption sites with collection of load diagrams, by district, municipality and parish (incl. PCVEs). History &gt;2022</p><p>For the\nmunicipality of \u00c9vora, the data collection of remote readings and load diagrams does not include CPEs with 1st generation meters, as this equipment is being\nprogressively replaced until the end of 2024.</p><p><br></p><p></p><p>1. The information made available by E-REDES constitutes an approximation to the values taken from the system and is based on the moment in which it is collected. Given that the connection points, the electricity distribution network, and the consumption and production values themselves are naturally very dynamic, it is safeguarded that the information made available may be subject to subsequent changes and updates, with the exception of any omissions and/or occasional inaccuracies of location that the information may contain.<br></p><p>2. In this way, E-REDES is not liable to third parties, namely, partners, service providers, contractors, users and customers, for damages that may arise as a result, direct or indirect, of the use of this Information, in particular when carrying out interventions, calculations and/or estimates, without confirming the accuracy and updating of the data, whereby it is duly noted that the consultation of this information does not affect the duty to promote a direct consultation with E-REDES in order to obtain updated information.</p><p><br></p><p><span style=\"font-size: inherit;\">The data provided by the E-REDES Open Data Portal is covered by open licenses (CC BY 4.0). There are no restrictions on access, under the commitment that data users cite the publisher.\u00a0Therefore, we suggest that you cite the Open Data E-REDES Portal as:</span></p><p><span style=\"font-size: inherit;\">E-REDES \u2013 Distribui\u00e7\u00e3o de Eletricidade, \u201cE-REDES Open Data Portal\u201d. Accessed in \u201cData\u201d. [Online] Available at </span><a aria-label=\"Link https://e-redes.opendatasoft.com/pages/homepage/\" class=\"fui-Link ___1rxvrpe f2hkw1w f3rmtva f1ewtqcl fyind8e f1k6fduh f1w7gpdv fk6fouc fjoy568 figsok6 f1hu3pq6 f11qmguv f19f4twv f1tyq0we f1g0x7ka fhxju0i f1qch9an f1cnd47f fqv5qza f1vmzxwi f1o700av f13mvf36 f1cmlufx f9n3di6 f1ids18y f1tx3yz7 f1deo86v f1eh06m1 f1iescvh fhgqx19 f1olyrje f1p93eir f1nev41a f1h8hb77 f1lqvz6u f10aw75t fsle3fq f17ae5zn\" href=\"https://e-redes.opendatasoft.com/pages/homepage/\" rel=\"noreferrer noopener\" target=\"_blank\" title=\"https://e-redes.opendatasoft.com/pages/homepage/\"><span style=\"font-size: inherit;\">https://e-redes.opendatasoft.com/pages/homepage/</span></a></p><p class=\"MsoNormal\" style=\"margin-bottom: 0cm; line-height: normal; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;\"><span lang=\"EN-US\" style=\"font-size: 10.5pt; font-family: Arial, sans-serif;\"><o:p><span class=\"ui-provider a b c d e f g h i j k l m n o p q r s t u v w x y z ab ac ae af ag ah ai aj ak\" dir=\"ltr\"></span></o:p></span></p><p class=\"\"><span style=\"font-size: inherit;\">If you share on social media, please add #PortalOpenData_E_REDES</span></p><p><span style=\"font-size: inherit;\"><br></span></p>", "description_pt": "<p>N\u00famero de locais de consumo de baixa tens\u00e3o com recolha de diagramas de carga, por distrito, concelho e freguesia (incl. PCVEs). Hist\u00f3rico &gt;2022</p><p>Para o concelho de \u00c9vora, os dados das recolhas de leituras remotas e diagramas de carga n\u00e3o incluem os c\u00f3digos de pontos de entrega (CPE) com contadores de 1\u00ba gera\u00e7\u00e3o, pois estes equipamentos est\u00e3o a ser progressivamente substitu\u00eddos at\u00e9 final de 2024.</p><p><br></p><p>1. A Informa\u00e7\u00e3o disponibilizada pela E-REDES constitui uma aproxima\u00e7\u00e3o aos valores retirados de sistema e tem por refer\u00eancia o momento em que a mesma \u00e9 recolhida. Atendendo a que os pontos de liga\u00e7\u00e3o, a rede de distribui\u00e7\u00e3o de eletricidade, e os pr\u00f3prios valores de consumo e de produ\u00e7\u00e3o s\u00e3o naturalmente muito din\u00e2micos, salvaguarda-se que a informa\u00e7\u00e3o disponibilizada poder\u00e1 ser objeto de subsequentes altera\u00e7\u00f5es e atualiza\u00e7\u00f5es, ficando igualmente ressalvadas eventuais omiss\u00f5es e/ou pontuais imprecis\u00f5es de localiza\u00e7\u00e3o que a informa\u00e7\u00e3o poder\u00e1 conter.</p><p>2. Desta forma a E-REDES n\u00e3o se responsabiliza perante terceiros, nomeadamente, parceiros, prestadores de servi\u00e7os, empreiteiros, utentes e clientes, pelos danos que possam surgir em consequ\u00eancia, direta ou indireta, do uso da presente Informa\u00e7\u00e3o, em particular aquando da realiza\u00e7\u00e3o de interven\u00e7\u00f5es, c\u00e1lculos e/ou estimativas, sem confirma\u00e7\u00e3o da exatid\u00e3o e atualiza\u00e7\u00e3o dos dados, pelo que devidamente se ressalva de que a consulta da presente informa\u00e7\u00e3o n\u00e3o prejudica o dever de se promover uma consulta direta \u00e0 E-REDES para obter informa\u00e7\u00e3o atualizada.</p><p><br></p><p><span style=\"font-size: inherit;\">Os dados fornecidos pelo Portal Open Data da E-REDES s\u00e3o abrangidos por licen\u00e7as abertas (</span><a aria-label=\"Link CC BY 4.0\" class=\"fui-Link ___1rxvrpe f2hkw1w f3rmtva f1ewtqcl fyind8e f1k6fduh f1w7gpdv fk6fouc fjoy568 figsok6 f1hu3pq6 f11qmguv f19f4twv f1tyq0we f1g0x7ka fhxju0i f1qch9an f1cnd47f fqv5qza f1vmzxwi f1o700av f13mvf36 f1cmlufx f9n3di6 f1ids18y f1tx3yz7 f1deo86v f1eh06m1 f1iescvh fhgqx19 f1olyrje f1p93eir f1nev41a f1h8hb77 f1lqvz6u f10aw75t fsle3fq f17ae5zn\" href=\"https://creativecommons.org/licenses/by/4.0/\" rel=\"noreferrer noopener\" target=\"_blank\" title=\"https://creativecommons.org/licenses/by/4.0/\">CC BY 4.0</a><span style=\"font-size: inherit;\">). N\u00e3o existem restri\u00e7\u00f5es ao seu acesso, sob o compromisso de os utilizadores dos dados citarem o publicador. Assim, sugerimos que cite o Portal Open Data E-REDES como:</span></p><p><span style=\"font-size: inherit;\">E-REDES \u2013 Distribui\u00e7\u00e3o de eletricidade, \u201cPortal Open Data E-REDES\u201d. Acedido em \u201cData\u201d. [Online] Dispon\u00edvel em </span><a aria-label=\"Link https://e-redes.opendatasoft.com/pages/homepage/\" class=\"fui-Link ___1rxvrpe f2hkw1w f3rmtva f1ewtqcl fyind8e f1k6fduh f1w7gpdv fk6fouc fjoy568 figsok6 f1hu3pq6 f11qmguv f19f4twv f1tyq0we f1g0x7ka fhxju0i f1qch9an f1cnd47f fqv5qza f1vmzxwi f1o700av f13mvf36 f1cmlufx f9n3di6 f1ids18y f1tx3yz7 f1deo86v f1eh06m1 f1iescvh fhgqx19 f1olyrje f1p93eir f1nev41a f1h8hb77 f1lqvz6u f10aw75t fsle3fq f17ae5zn\" href=\"https://e-redes.opendatasoft.com/pages/homepage/\" rel=\"noreferrer noopener\" target=\"_blank\" title=\"https://e-redes.opendatasoft.com/pages/homepage/\"><sp