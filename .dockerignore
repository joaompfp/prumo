# Deny by default: historical sources/data, docs, tests and local state stay out.
**
!Dockerfile
!.dockerignore
!requirements.txt
!entrypoint.sh
!app/
!app/**
!static/
!static/**
!ingest/
!ingest/**
!backoffice/
!backoffice/**
!registry/
!registry/**

# Apply these last, including inside otherwise allowed runtime directories.
**/.git
**/.venv*
**/venv*
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/.coverage*
**/*.egg-info
**/.env
**/.env.*
**/.envrc
**/*.env
**/*.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/.netrc
**/.npmrc
**/.pypirc
**/.git-credentials
**/.ssh
**/.aws
**/.secrets*
**/.credentials*
**/credentials*
**/secrets*
**/*.sqlite*
**/*.db
**/*.duckdb*
**/*.bak
**/*.swp
**/*.swo
**/*~
**/.DS_Store
